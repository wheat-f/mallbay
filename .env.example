# ─── 数据库 ─────────────────────────────────────────────────────
# 本地开发：host 用 localhost
# 生产（Docker Compose）：host 用服务名 postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mallbay?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mallbay

# ─── Redis ──────────────────────────────────────────────────────
# 宿主机端口使用 16379，避免部分 Windows/WSL 环境保留 6379 附近端口。
REDIS_HOST_PORT=16379
REDIS_URL="redis://localhost:16379"

# ─── JWT ────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="replace-with-a-long-access-secret"
JWT_REFRESH_SECRET="replace-with-a-long-refresh-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── 跨域 / 前端地址 ────────────────────────────────────────────
# 生产时改为真实域名，不带尾部斜杠
WEB_ORIGIN="http://localhost:3000"

# ─── Next.js 公共变量 ────────────────────────────────────────────
# 浏览器端可访问的 API 地址
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ─── 阿里云 OSS ─────────────────────────────────────────────────
OSS_REGION="oss-cn-beijing"
OSS_ACCESS_KEY_ID="your-access-key-id"
OSS_ACCESS_KEY_SECRET="your-access-key-secret"
OSS_BUCKET="mallbay-dev"
# OSS_CDN_HOST=""   # 可选，CDN 域名（不含 https://）

# ─── 本地 OSS 替代模式（开发调试用，不需要阿里云密钥）────────────
# OSS_PROVIDER="local"
# OSS_LOCAL_DIR=".local/oss"
# OSS_PUBLIC_BASE_URL="http://localhost:3001/local-oss"

# ─── 阿里云 ACR（docker-compose.prod.yml 使用）──────────────────
# 生产 .env 中需填写以下内容
ACR_REGISTRY="registry.cn-hangzhou.aliyuncs.com"
ACR_NAMESPACE="mallbay"
IMAGE_TAG="latest"
