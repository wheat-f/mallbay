{
  "name": "@mallbay/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch -p tsconfig.app.json",
    "build": "nest build -p tsconfig.app.json",
    "start": "node dist/main.js",
    "test": "tsx --tsconfig tsconfig.app.json --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "test:flow": "tsx --tsconfig tsconfig.app.json --test src/flows/finance-workflow.e2e.test.ts src/flows/store-flow.e2e.test.ts",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "db:preflight": "tsx --tsconfig tsconfig.app.json src/prisma/preflight-db-invariants.ts",
    "db:historical-gate": "tsx --tsconfig tsconfig.app.json src/prisma/historical-lifecycle-gate.ts",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:seed": "tsx prisma/seed.ts",
    "settings:migrate": "tsx scripts/migrate-settings-workbench.ts",
    "settings:migrate:domains": "tsx scripts/migrate-settings-domains.ts",
    "settings:migrate:finance-settlement": "tsx scripts/migrate-finance-settlement.ts",
    "permissions:bootstrap:hq": "node dist/permissions/bootstrap-hq-admin.js"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "24.12.3",
    "tsx": "^4.19.2"
  },
  "dependencies": {
    "ali-oss": "^6.23.0",
    "bcryptjs": "2.4.3"
  }
}
