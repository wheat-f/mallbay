model RebateLog {
  id          String       @id @default(cuid())
  rebateId    String
  status      RebateStatus
  note        String?
  createdById String
  createdAt   DateTime     @default(now())

  rebate    CustomerRebate @relation(fields: [rebateId], references: [id], onDelete: Cascade)
  createdBy User           @relation("RebateLogCreatedBy", fields: [createdById], references: [id])

  @@index([rebateId])
  @@index([createdById])
