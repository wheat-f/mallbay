  paymentRecordId  String?               @unique
  exceptionReason  String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  store          Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  applicant      User                @relation("ReimbursementApplicant", fields: [applicantId], references: [id])
  expense        ExpenseApplication? @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  reviewedBy     User?               @relation("ReimbursementReviewedBy", fields: [reviewedById], references: [id])
  paymentAccount PaymentAccount?     @relation("ReimbursementPaymentAccount", fields: [paymentAccountId], references: [id], onDelete: SetNull)
  paymentRecord  PaymentRecord?      @relation("ReimbursementPaymentRecord", fields: [paymentRecordId], references: [id], onDelete: SetNull)

  @@index([storeId, status])
  @@index([applicantId])
  @@index([expenseId])
