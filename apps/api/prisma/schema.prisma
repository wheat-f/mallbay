  currentNode   FinanceApprovalNode?
  submittedAt   DateTime?
  reviewNote    String?
  reviewedById  String?
  reviewedAt    DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  store          Store                      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  applicant      User                       @relation("ExpenseApplicant", fields: [applicantId], references: [id])
  reviewedBy     User?                      @relation("ExpenseReviewedBy", fields: [reviewedById], references: [id])
  reimbursements ReimbursementApplication[]

  @@index([storeId, status])
  @@index([applicantId])
}

model ReimbursementApplication {
  id               String                @id @default(cuid())
  applicationNo    String                @unique
  storeId          String
  applicantId      String
  expenseId        String?
  title            String
  amountCents      Int
  reason           String
  status           FinanceApprovalStatus @default(PENDING)
