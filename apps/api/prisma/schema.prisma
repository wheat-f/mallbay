model Invoice {
  id          String        @id @default(cuid())
  storeId     String
  orderId     String
  title       String
  taxNo       String?
  amountCents Int
  status      InvoiceStatus @default(APPLIED)
  invoiceNo   String?       @unique
  fileUrl     String?
  appliedById String
  issuedAt    DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  store     Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order     Order        @relation(fields: [orderId], references: [id])
  appliedBy User         @relation("InvoiceAppliedBy", fields: [appliedById], references: [id])
  logs      InvoiceLog[]

  @@index([storeId, status])
