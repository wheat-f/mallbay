model PaymentRecord {
  id           String            @id @default(cuid())
  storeId      String
  accountId    String?
  type         PaymentRecordType
  direction    PaymentDirection
  amountCents  Int
  sourceType   String?
  sourceId     String?
  note         String?
  createdById  String
  occurredAt   DateTime          @default(now())
  createdAt    DateTime          @default(now())
  idempotencyKey String?
  reversalOfId String?           @unique
  reversedById String?           @unique

  store         Store                     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  account       PaymentAccount?           @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdBy     User                      @relation("PaymentRecordCreatedBy", fields: [createdById], references: [id])
  reimbursement ReimbursementApplication? @relation("ReimbursementPaymentRecord")
  reversalOf    PaymentRecord?            @relation("PaymentRecordReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversedBy    PaymentRecord?            @relation("PaymentRecordReversal")

  @@unique([type, sourceId], map: "PaymentRecord_type_sourceId_key")
  @@index([storeId, type])
  @@index([sourceType, sourceId])
  @@index([createdById])
  @@unique([storeId, idempotencyKey])
}

model FinanceApprovalRecord {
