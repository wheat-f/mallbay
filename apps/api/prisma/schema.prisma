  account   PaymentAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdBy User            @relation("PaymentRecordCreatedBy", fields: [createdById], references: [id])

  @@index([storeId, type])
  @@index([sourceId])
