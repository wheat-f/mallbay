generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── User ────────────────────────────────────────────────────────────────────
// 所有用户默认拥有客户角色（无需额外记录）
// 审核员角色通过 isAuditor 标记
// 门店员工角色通过 StoreMember 表体现

model User {
  id               String  @id @default(cuid())
  username         String  @unique
  passwordHash     String
  refreshTokenHash String?

  nickname  String? // 默认展示 username，可修改
  avatarUrl String? // 存储阿里云 OSS URL

  // 可绑定的登录凭据（绑定后支持对应方式登录）
  email        String? @unique
  phone        String? @unique
  wechatOpenId String? @unique
  alipayUserId String? @unique

  // 运营人员角色（目前仅审核员一个岗位）
  isAuditor Boolean @default(false)

  storeMembers               StoreMember[]
  sentInvitations            StoreInvitation[]          @relation("InvitedBy")
  receivedInvitations        StoreInvitation[]          @relation("InvitedUser")
  notifications              Notification[]
  submittedSubmissions       StoreAuditSubmission[]     @relation("SubmittedBy")
  reviewedSubmissions        StoreAuditSubmission[]     @relation("ReviewedBy")
  createdStores              Store[]                    @relation("CreatedBy")
  ownedCustomers             Customer[]                 @relation("CustomerOwner")
  customerNotes              CustomerNote[]             @relation("CustomerNoteCreatedBy")
  salesOrders                Order[]                    @relation("OrderSalesPerson")
  orderPayments              OrderPayment[]             @relation("OrderPaymentCreatedBy")
  constructionProfile        ConstructionWorkerProfile?
  constructionAssigned       ConstructionAssignment[]   @relation("ConstructionAssignedWorker")
  constructionDispatched     ConstructionRecord[]       @relation("ConstructionDispatchedBy")
  constructionPhotos         ConstructionPhoto[]        @relation("ConstructionPhotoUploadedBy")
  qualityChecks              ConstructionRecord[]       @relation("ConstructionQualityCheckedBy")
  leaveRequests              LeaveRequest[]             @relation("LeaveRequestWorker")
  schedules                  Schedule[]                 @relation("ScheduleWorker")
  commissionSnapshots        WorkerCommissionSnapshot[] @relation("WorkerCommissionWorker")
  createdCommissionSnapshots WorkerCommissionSnapshot[] @relation("WorkerCommissionCreatedBy")
  inventoryMovements         InventoryMovement[]        @relation("InventoryMovementCreatedBy")
  purchaseOrders             PurchaseOrder[]            @relation("PurchaseOrderCreatedBy")
  warranties                 Warranty[]                 @relation("WarrantyCreatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Store ───────────────────────────────────────────────────────────────────

enum StoreStatus {
  DRAFTED // 筹办中：审核员刚创建，店长尚未提交信息
  PENDING_REVIEW // 审核中：店长已提交，等待审核员审核
  PUBLISHED // 公开：审核通过，对外展示
  FROZEN // 冻结：暂停运营，不对外展示
}

model Store {
  id     String      @id @default(cuid())
  status StoreStatus @default(DRAFTED)

  // 当前对外展示的内容（审核通过后从 StoreAuditSubmission 同步过来）
  name        String // 审核员创建时初始化，后续可通过审核更新
  address     String?
  description String? // 最多 300 字，在应用层校验

  createdById String?
  createdBy   User?   @relation("CreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  members                    StoreMember[]
  photos                     StorePhoto[]
  submissions                StoreAuditSubmission[]
  invitations                StoreInvitation[]
  customers                  Customer[]
  products                   Product[]
  orders                     Order[]
  paymentAccounts            PaymentAccount[]
  dailyCapacities            DailyCapacity[]
  constructionWorkerProfiles ConstructionWorkerProfile[]
  constructionRecords        ConstructionRecord[]
  leaveRequests              LeaveRequest[]
  schedules                  Schedule[]
  inventoryBatches           InventoryBatch[]
  inventoryMovements         InventoryMovement[]
  purchaseOrders             PurchaseOrder[]
  warranties                 Warranty[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
  @@index([status])
}

// 当前对外展示的门店照片（审核通过后从 StoreSubmissionPhoto 同步过来）
model StorePhoto {
  id      String  @id @default(cuid())
  storeId String
  url     String // 阿里云 OSS URL
  isCover Boolean @default(false) // 同一门店只有一张封面，由 partial unique index 保证
  order   Int     @default(0) // 展示顺序

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([storeId])
}

// ─── Store Audit ─────────────────────────────────────────────────────────────

enum SubmissionStatus {
  PENDING // 待审核
  APPROVED // 已通过
  REJECTED // 已驳回
}

// 每次店长提交送审时创建一条记录，同一时刻只有一条 PENDING（由 partial unique index 保证）
// 审核通过后将本条记录的内容同步到 Store 和 StorePhoto 表
model StoreAuditSubmission {
  id            String  @id @default(cuid())
  storeId       String
  submittedById String
  reviewedById  String?

  // 本次提交的内容快照
  name        String
  address     String?
  description String?
  photos      StoreSubmissionPhoto[]

  status     SubmissionStatus @default(PENDING)
  reviewNote String? // 驳回时审核员填写的原因
  reviewedAt DateTime?

  store       Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  submittedBy User  @relation("SubmittedBy", fields: [submittedById], references: [id])
  reviewedBy  User? @relation("ReviewedBy", fields: [reviewedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
  @@index([submittedById])
  @@index([status])
}

// 送审时提交的照片快照（审核通过后同步到 StorePhoto）
model StoreSubmissionPhoto {
  id           String  @id @default(cuid())
  submissionId String
  url          String // 阿里云 OSS URL（上传在送审前完成）
  isCover      Boolean @default(false) // 同一送审提交只有一张封面，由 partial unique index 保证
  order        Int     @default(0)

  submission StoreAuditSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([submissionId])
}

// ─── Store Members ───────────────────────────────────────────────────────────

enum StorePosition {
  MANAGER // 店长
  SALES // 销售
  PURCHASING // 采购
  FINANCE // 财务
  SCHEDULER // 排班员
  CONSTRUCTION // 施工员
  APPRENTICE // 学徒
}

// ─── Phase 1 Customer, Product, Order ───────────────────────────────────────

enum CustomerType {
  PERSONAL
  COMPANY
}

enum Gender {
  MALE
  FEMALE
  UNKNOWN
}

enum CustomerSourceType {
  ONLINE_DOUYIN
  ONLINE_XIAOHONGSHU
  ONLINE_KUAISHOU
  OFFLINE_STORE
  REFERRAL
  PARTNER
  OTHER
}

enum ProductCategory {
  PPF
  COLOR_FILM
  HEAT_FILM
  MODIFICATION
  OTHER
}

enum ProductUnit {
  ROLL
  METER
  PIECE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum ConstructionType {
  PPF
  COLOR_FILM
  HEAT_FILM
  MODIFICATION
  INSPECTION
}

enum ConstructionLocation {
  IN_STORE
  OUTSIDE
}

enum OrderStatus {
  PENDING_DISPATCH
  DISPATCHED
  IN_CONSTRUCTION
  COMPLETED
  WARRANTIED
  CANCELLED
}

enum PaymentType {
  DEPOSIT
  BALANCE
  FULL
}

enum PaymentAccountType {
  CORPORATE
  PERSONAL
  WECHAT
  ALIPAY
  OTHER
}

enum ConstructionTaskStatus {
  DISPATCHED
  IN_CONSTRUCTION
  COMPLETED
}

enum ConstructionPhotoStage {
  BEFORE
  DURING
  AFTER
}

enum QualityCheckResult {
  PASS
  REWORK_REQUIRED
}

enum WorkerSkillTag {
  PPF
  COLOR_FILM
  HEAT_FILM
  MODIFICATION
  INSPECTION
  OUTSIDE
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ScheduleStatus {
  WORKING
  REST
  OUTSIDE
}

enum InventoryMovementType {
  PURCHASE_IN
  ORDER_LOCK
  ORDER_OUT
  STOCK_RELEASE
  STOCK_ADJUST
  DAMAGE
  TRANSFER
  UNIT_CONVERSION
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIAL_RECEIVED
  RECEIVED
  CANCELLED
}

enum WarrantyStatus {
  ACTIVE
  EXPIRED
  VOIDED
}

model Customer {
  id             String              @id @default(cuid())
  storeId        String
  ownerUserId    String
  customerType   CustomerType
  name           String?
  gender         Gender?
  birthday       DateTime?
  companyName    String?
  contactPerson  String?
  phoneEncrypted String
  phoneHash      String
  wechat         String?
  sourceType     CustomerSourceType?
  sourceDetail   String?
  referrerId     String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  store      Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  owner      User              @relation("CustomerOwner", fields: [ownerUserId], references: [id])
  referrer   Customer?         @relation("CustomerReferrals", fields: [referrerId], references: [id])
  referrals  Customer[]        @relation("CustomerReferrals")
  vehicles   CustomerVehicle[]
  notes      CustomerNote[]
  orders     Order[]
  warranties Warranty[]

  @@unique([storeId, phoneHash])
  @@index([storeId, ownerUserId])
  @@index([storeId, name])
  @@index([storeId, companyName])
}

model CustomerVehicle {
  id           String   @id @default(cuid())
  customerId   String
  carPlate     String?
  vinEncrypted String?
  vinHash      String?
  carModel     String
  carColor     String?
  photoUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders     Order[]
  warranties Warranty[]

  @@index([customerId])
  @@index([carPlate])
  @@index([vinHash])
}

model CustomerNote {
  id          String   @id @default(cuid())
  customerId  String
  createdById String
  content     String
  createdAt   DateTime @default(now())

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdBy User     @relation("CustomerNoteCreatedBy", fields: [createdById], references: [id])

  @@index([customerId, createdAt])
}

model Product {
  id             String          @id @default(cuid())
  storeId        String
  brand          String
  name           String
  model          String
  category       ProductCategory
  specification  String?
  unit           ProductUnit
  warrantyYears  Int?
  basePriceCents Int
  status         ProductStatus   @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  store              Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderItems         OrderItem[]
  inventoryBatches   InventoryBatch[]
  inventoryMovements InventoryMovement[]
  purchaseOrderItems PurchaseOrderItem[]

  @@unique([storeId, brand, model])
  @@index([storeId, category])
  @@index([storeId, status])
}

model Order {
  id                   String               @id @default(cuid())
  storeId              String
  orderNo              String               @unique
  customerId           String
  vehicleId            String?
  salesPersonId        String
  constructionType     ConstructionType
  constructionLocation ConstructionLocation
  constructionAddress  String?
  appointmentDate      DateTime?
  appointmentTimeSlot  String?
  status               OrderStatus          @default(PENDING_DISPATCH)
  remark               String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  store              Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer           Customer            @relation(fields: [customerId], references: [id])
  vehicle            CustomerVehicle?    @relation(fields: [vehicleId], references: [id])
  salesPerson        User                @relation("OrderSalesPerson", fields: [salesPersonId], references: [id])
  items              OrderItem[]
  amount             OrderAmount?
  payments           OrderPayment[]
  constructionRecord ConstructionRecord?
  inventoryMovements InventoryMovement[]
  warranty           Warranty?

  @@index([storeId, status])
  @@index([storeId, salesPersonId])
  @@index([customerId])
  @@index([vehicleId])
}

model OrderItem {
  id             String @id @default(cuid())
  orderId        String
  productId      String
  quantity       Int
  unitPriceCents Int
  amountCents    Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}

model OrderAmount {
  id                   String @id @default(cuid())
  orderId              String @unique
  productAmountCents   Int
  laborCostCents       Int
  totalAmountCents     Int
  paidAmountCents      Int    @default(0)
  outstandingCents     Int
  salesCommissionCents Int    @default(0)
  materialCostCents    Int    @default(0)
  profitCents          Int    @default(0)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model PaymentAccount {
  id        String             @id @default(cuid())
  storeId   String
  name      String
  type      PaymentAccountType
  bankName  String?
  accountNo String?
  isDefault Boolean            @default(false)
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  store    Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  payments OrderPayment[]

  @@index([storeId, isActive])
}

model OrderPayment {
  id          String      @id @default(cuid())
  orderId     String
  accountId   String
  paymentType PaymentType
  amountCents Int
  paidAt      DateTime
  createdById String
  createdAt   DateTime    @default(now())

  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  account   PaymentAccount @relation(fields: [accountId], references: [id])
  createdBy User           @relation("OrderPaymentCreatedBy", fields: [createdById], references: [id])

  @@index([orderId])
  @@index([accountId])
}

// ─── Phase 2 Construction ───────────────────────────────────────────────────

model DailyCapacity {
  id                 String   @id @default(cuid())
  storeId            String
  date               DateTime @db.Date
  inStoreCapacity    Int      @default(0)
  inStoreReserved    Int      @default(0)
  outsideCapacity    Int      @default(0)
  outsideReserved    Int      @default(0)
  heatFilmCapacity   Int      @default(0)
  heatFilmReserved   Int      @default(0)
  inspectionCapacity Int      @default(0)
  inspectionReserved Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, date])
  @@index([storeId])
}

model ConstructionWorkerProfile {
  id             String           @id @default(cuid())
  storeId        String
  userId         String           @unique
  canWorkOutside Boolean          @default(false)
  skillTags      WorkerSkillTag[]
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([storeId, isActive])
}

model ConstructionRecord {
  id                 String                 @id @default(cuid())
  storeId            String
  orderId            String                 @unique
  status             ConstructionTaskStatus @default(DISPATCHED)
  dispatchedById     String
  dispatchedAt       DateTime               @default(now())
  startedAt          DateTime?
  completedAt        DateTime?
  actualMinutes      Int?
  overtimeMinutes    Int                    @default(0)
  qualityResult      QualityCheckResult?
  qualityNote        String?
  qualityCheckedById String?
  qualityCheckedAt   DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  store               Store                      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order               Order                      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dispatchedBy        User                       @relation("ConstructionDispatchedBy", fields: [dispatchedById], references: [id])
  qualityCheckedBy    User?                      @relation("ConstructionQualityCheckedBy", fields: [qualityCheckedById], references: [id])
  assignments         ConstructionAssignment[]
  photos              ConstructionPhoto[]
  commissionSnapshots WorkerCommissionSnapshot[]

  @@index([storeId, status])
  @@index([dispatchedById])
}

model ConstructionAssignment {
  id           String   @id @default(cuid())
  recordId     String
  orderId      String
  workerUserId String
  assignedAt   DateTime @default(now())

  record ConstructionRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  worker User               @relation("ConstructionAssignedWorker", fields: [workerUserId], references: [id], onDelete: Cascade)

  @@unique([orderId, workerUserId])
  @@index([recordId])
  @@index([workerUserId])
}

model ConstructionPhoto {
  id           String                 @id @default(cuid())
  recordId     String
  stage        ConstructionPhotoStage
  url          String
  uploadedById String
  takenAt      DateTime?
  createdAt    DateTime               @default(now())

  record         ConstructionRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  uploadedBy     User               @relation("ConstructionPhotoUploadedBy", fields: [uploadedById], references: [id])
  warrantyPhotos WarrantyPhoto[]

  @@index([recordId, stage])
  @@index([uploadedById])
}

model LeaveRequest {
  id        String             @id @default(cuid())
  storeId   String
  workerId  String
  startDate DateTime           @db.Date
  endDate   DateTime           @db.Date
  reason    String?
  status    LeaveRequestStatus @default(PENDING)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  store  Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  worker User  @relation("LeaveRequestWorker", fields: [workerId], references: [id], onDelete: Cascade)

  @@index([storeId, startDate, endDate])
  @@index([workerId, status])
}

model Schedule {
  id        String         @id @default(cuid())
  storeId   String
  workerId  String
  date      DateTime       @db.Date
  status    ScheduleStatus @default(WORKING)
  note      String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  store  Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  worker User  @relation("ScheduleWorker", fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([workerId, date])
  @@index([storeId, date])
}

model WorkerCommissionSnapshot {
  id              String   @id @default(cuid())
  recordId        String
  orderId         String
  workerUserId    String
  amountCents     Int
  calculationNote String
  createdById     String
  createdAt       DateTime @default(now())

  record    ConstructionRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  worker    User               @relation("WorkerCommissionWorker", fields: [workerUserId], references: [id])
  createdBy User               @relation("WorkerCommissionCreatedBy", fields: [createdById], references: [id])

  @@unique([recordId, workerUserId])
  @@index([orderId])
  @@index([workerUserId])
}

// ─── Phase 3 Inventory, Purchase, Warranty ──────────────────────────────────

model InventoryBatch {
  id                String    @id @default(cuid())
  storeId           String
  productId         String
  batchNo           String
  supplierName      String?
  totalQuantity     Int
  availableQuantity Int
  lockedQuantity    Int       @default(0)
  unitCostCents     Int?
  productionDate    DateTime?
  receivedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  store     Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product   Product             @relation(fields: [productId], references: [id])
  movements InventoryMovement[]

  @@unique([storeId, productId, batchNo])
  @@index([storeId, productId])
  @@index([storeId, batchNo])
}

model InventoryMovement {
  id             String                @id @default(cuid())
  storeId        String
  batchId        String
  productId      String
  orderId        String?
  movementType   InventoryMovementType
  quantity       Int
  fromUnit       ProductUnit?
  toUnit         ProductUnit?
  conversionRate Float?
  note           String?
  createdById    String
  createdAt      DateTime              @default(now())

  store     Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  batch     InventoryBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id])
  order     Order?         @relation(fields: [orderId], references: [id])
  createdBy User           @relation("InventoryMovementCreatedBy", fields: [createdById], references: [id])

  @@index([storeId, createdAt])
  @@index([orderId])
  @@index([batchId])
  @@index([productId])
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  storeId      String
  orderNo      String              @unique
  supplierName String?
  status       PurchaseOrderStatus @default(DRAFT)
  expectedAt   DateTime?
  createdById  String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  store     Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdBy User                @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id])
  items     PurchaseOrderItem[]

  @@index([storeId, status])
  @@index([createdById])
}

model PurchaseOrderItem {
  id               String @id @default(cuid())
  purchaseOrderId  String
  productId        String
  quantity         Int
  receivedQuantity Int    @default(0)
  unitCostCents    Int?

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId])
  @@index([productId])
}

model Warranty {
  id          String         @id @default(cuid())
  storeId     String
  orderId     String         @unique
  customerId  String
  vehicleId   String?
  warrantyNo  String         @unique
  status      WarrantyStatus @default(ACTIVE)
  scope       String
  startDate   DateTime       @db.Date
  endDate     DateTime       @db.Date
  createdById String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  store     Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order     Order            @relation(fields: [orderId], references: [id])
  customer  Customer         @relation(fields: [customerId], references: [id])
  vehicle   CustomerVehicle? @relation(fields: [vehicleId], references: [id])
  createdBy User             @relation("WarrantyCreatedBy", fields: [createdById], references: [id])
  photos    WarrantyPhoto[]

  @@index([storeId, status])
  @@index([customerId])
  @@index([vehicleId])
}

model WarrantyPhoto {
  id                  String   @id @default(cuid())
  warrantyId          String
  constructionPhotoId String?
  url                 String
  createdAt           DateTime @default(now())

  warranty          Warranty           @relation(fields: [warrantyId], references: [id], onDelete: Cascade)
  constructionPhoto ConstructionPhoto? @relation(fields: [constructionPhotoId], references: [id], onDelete: SetNull)

  @@index([warrantyId])
  @@index([constructionPhotoId])
}

// 一个用户同一时间只能属于一家门店（数据库层强制）
// 冻结期间员工可接受其他门店邀请，接受时系统自动删除其在冻结门店的 StoreMember 记录
model StoreMember {
  id       String        @id @default(cuid())
  storeId  String
  userId   String
  position StorePosition

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, userId]) // 同一门店内每个用户只能有一个岗位
  @@unique([userId]) // 一个用户只能属于一家门店
}

// ─── Store Invitations ───────────────────────────────────────────────────────

enum InvitationStatus {
  PENDING // 待处理
  ACCEPTED // 已接受
  REJECTED // 已拒绝
  CANCELLED // 已撤销（店长主动取消）
}

model StoreInvitation {
  id            String           @id @default(cuid())
  storeId       String
  invitedById   String
  invitedUserId String
  position      StorePosition // 邀请加入后的岗位（不含 MANAGER）
  status        InvitationStatus @default(PENDING)

  store       Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  invitedBy   User  @relation("InvitedBy", fields: [invitedById], references: [id])
  invitedUser User  @relation("InvitedUser", fields: [invitedUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invitedUserId])
  @@index([storeId])
}

// ─── Notifications ───────────────────────────────────────────────────────────

enum NotificationType {
  STORE_INVITATION // 收到门店邀请
  INVITATION_ACCEPTED // 邀请被接受
  INVITATION_REJECTED // 邀请被拒绝
  AUDIT_APPROVED // 送审通过
  AUDIT_REJECTED // 送审驳回（含驳回原因）
  STORE_FROZEN // 门店被冻结
  STORE_UNFROZEN // 门店解冻
  REMOVED_FROM_STORE // 被移出门店（开除或店长变更）
  PASSWORD_RESET // 密码被审核员重置
}

model Notification {
  id      String           @id @default(cuid())
  userId  String
  type    NotificationType
  payload Json // 各类型自定义的附加数据，例如 storeId、storeName、reviewNote 等
  isRead  Boolean          @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt(sort: Desc)])
}
