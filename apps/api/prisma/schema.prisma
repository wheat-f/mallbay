}

model AfterSalePhoto {
  id           String              @id @default(cuid())
  afterSaleId  String
  stage        AfterSalePhotoStage
  url          String
  note         String?
  uploadedById String?
  createdAt    DateTime            @default(now())

  afterSale  AfterSale @relation(fields: [afterSaleId], references: [id], onDelete: Cascade)
  uploadedBy User?     @relation("AfterSalePhotoUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([afterSaleId, stage, createdAt])
  @@index([uploadedById])
}

model AfterSaleAssignment {
  id           String   @id @default(cuid())
  afterSaleId  String
  workerUserId String
  assignedById String
  assignedAt   DateTime @default(now())

  afterSale  AfterSale @relation(fields: [afterSaleId], references: [id], onDelete: Cascade)
  worker     User      @relation("AfterSaleAssignedWorker", fields: [workerUserId], references: [id], onDelete: Cascade)
  assignedBy User      @relation("AfterSaleAssignedBy", fields: [assignedById], references: [id])

  @@unique([afterSaleId, workerUserId])
  @@index([workerUserId])
}

model AfterSaleCostEntry {
  id              String                 @id @default(cuid())
  storeId         String
  afterSaleId     String
  category        AfterSaleCostCategory
  direction       AfterSaleCostDirection
  amountCents     Int
  reason          String
  paymentRecordId String?
  status          AfterSaleCostStatus    @default(CONFIRMED)
  reversalOfId    String?
  reversalReason  String?
  recordedById    String
  reversedById    String?
  confirmedAt     DateTime               @default(now())
  reversedAt      DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  store      Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  afterSale  AfterSale @relation(fields: [afterSaleId], references: [id], onDelete: Cascade)
  recordedBy User      @relation("AfterSaleCostRecordedBy", fields: [recordedById], references: [id])
  reversedBy User?     @relation("AfterSaleCostReversedBy", fields: [reversedById], references: [id])

  @@index([storeId, category, confirmedAt])
  @@index([afterSaleId, status])
