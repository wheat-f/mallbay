generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── User ────────────────────────────────────────────────────────────────────
// 所有用户默认拥有客户角色（无需额外记录）
// 审核员角色通过 isAuditor 标记
// 门店员工角色通过 StoreMember 表体现

model User {
  id               String  @id @default(cuid())
  username         String  @unique
  passwordHash     String
  refreshTokenHash String?

  nickname  String? // 默认展示 username，可修改
  avatarUrl String? // 存储阿里云 OSS URL

  // 可绑定的登录凭据（绑定后支持对应方式登录）
  email        String? @unique
  phone        String? @unique
  wechatOpenId String? @unique
  alipayUserId String? @unique

  // 运营人员角色（目前仅审核员一个岗位）
  isAuditor         Boolean   @default(false)
  isActive          Boolean   @default(true)
  loginFailureCount Int       @default(0)
  lockedUntil       DateTime?

  storeMembers                   StoreMember[]
  sentInvitations                StoreInvitation[]            @relation("InvitedBy")
  receivedInvitations            StoreInvitation[]            @relation("InvitedUser")
  notifications                  Notification[]
  authSessions                   AuthSession[]
  submittedSubmissions           StoreAuditSubmission[]       @relation("SubmittedBy")
  reviewedSubmissions            StoreAuditSubmission[]       @relation("ReviewedBy")
  createdStores                  Store[]                      @relation("CreatedBy")
  createdPricingRuleSets         PricingRuleSet[]             @relation("PricingRuleSetCreatedBy")
  publishedPricingRuleSets       PricingRuleSet[]             @relation("PricingRuleSetPublishedBy")
  createdPricingTemplates        PricingRuleTemplate[]        @relation("PricingRuleTemplateCreatedBy")
  publishedPricingTemplates      PricingRuleTemplateVersion[] @relation("PricingRuleTemplateVersionPublishedBy")
  createdPricingTemplateVersions PricingRuleTemplateVersion[] @relation("PricingRuleTemplateVersionCreatedBy")
  createdVehiclePriceClasses     VehiclePriceClass[]          @relation("VehiclePriceClassCreatedBy")
  createdVehicleMappings         VehicleModelMapping[]        @relation("VehicleModelMappingCreatedBy")
  pricingCalculations            PricingCalculation[]         @relation("PricingCalculationCreatedBy")
  salesQuotes                    SalesQuote[]                 @relation("SalesQuoteSalesPerson")
  submittedPricingApprovals      PricingApproval[]            @relation("PricingApprovalSubmittedBy")
  reviewedPricingApprovals       PricingApproval[]            @relation("PricingApprovalReviewedBy")
  ownedCustomers                 Customer[]                   @relation("CustomerOwner")
  customerNotes                  CustomerNote[]               @relation("CustomerNoteCreatedBy")
  customerTags                   CustomerTag[]                @relation("CustomerTagCreatedBy")
  vehicleChanges                 VehicleOwnershipHistory[]    @relation("VehicleChangeOperatedBy")
  disabledVehicles               CustomerVehicle[]            @relation("VehicleDisabledBy")
  salesOrders                    Order[]                      @relation("OrderSalesPerson")
  orderPayments                  OrderPayment[]               @relation("OrderPaymentCreatedBy")
  statementsConfirmed            CustomerStatement[]          @relation("CustomerStatementConfirmedBy")
  customerReceiptsCreated        CustomerReceipt[]            @relation("CustomerReceiptCreatedBy")
  customerReceiptsPosted         CustomerReceipt[]            @relation("CustomerReceiptPostedBy")
  customerReceiptsReversed       CustomerReceipt[]            @relation("CustomerReceiptReversedBy")
  customerReceiptReversals       CustomerReceiptReversal[]    @relation("CustomerReceiptReversalCreatedBy")
  constructionProfile            ConstructionWorkerProfile?
  constructionAssigned           ConstructionAssignment[]     @relation("ConstructionAssignedWorker")
  constructionDispatched         ConstructionRecord[]         @relation("ConstructionDispatchedBy")
  constructionPhotos             ConstructionPhoto[]          @relation("ConstructionPhotoUploadedBy")
  constructionCostWorkerLines    ConstructionCostWorkerLine[]
  qualityChecks                  ConstructionRecord[]         @relation("ConstructionQualityCheckedBy")
  constructionQualityHistory    ConstructionQualityHistory[] @relation("ConstructionQualityCheckedByHistory")
  revokedQualityHistory         ConstructionQualityHistory[] @relation("ConstructionQualityRevokedBy")
  leaveRequests                  LeaveRequest[]               @relation("LeaveRequestWorker")
  reviewedLeaveRequests          LeaveRequest[]               @relation("LeaveRequestReviewedBy")
  schedules                      Schedule[]                   @relation("ScheduleWorker")
  commissionSnapshots            WorkerCommissionSnapshot[]   @relation("WorkerCommissionWorker")
  createdCommissionSnapshots     WorkerCommissionSnapshot[]   @relation("WorkerCommissionCreatedBy")
  inventoryMovements             InventoryMovement[]          @relation("InventoryMovementCreatedBy")
  warehousesCreated              Warehouse[]                  @relation("WarehouseCreatedBy")
  inventoryAllocationsLocked     OrderInventoryAllocation[]   @relation("InventoryAllocationLockedBy")
  inventoryAllocationsOut        OrderInventoryAllocation[]   @relation("InventoryAllocationOutboundBy")
  purchaseRequirements           PurchaseRequirement[]        @relation("PurchaseRequirementCreatedBy")
  purchaseOrders                 PurchaseOrder[]              @relation("PurchaseOrderCreatedBy")
  purchaseOrdersResponsible      PurchaseOrder[]              @relation("PurchaseOrderPurchaser")
  orderAmendmentRequests         OrderAmendmentRequest[]      @relation("OrderAmendmentRequestedBy")
  orderAmendmentReviews          OrderAmendmentRequest[]      @relation("OrderAmendmentReviewedBy")
  suppliersCreated               Supplier[]                   @relation("SupplierCreatedBy")
  supplierContactsCreated        SupplierContact[]            @relation("SupplierContactCreatedBy")
  supplierRatingsCreated         SupplierRatingHistory[]      @relation("SupplierRatingCreatedBy")
  warranties                     Warranty[]                   @relation("WarrantyCreatedBy")
  afterSalesCreated              AfterSale[]                  @relation("AfterSaleCreatedBy")
  afterSalesAssigned             AfterSaleAssignment[]        @relation("AfterSaleAssignedWorker")
  afterSalesAssignedBy           AfterSaleAssignment[]        @relation("AfterSaleAssignedBy")
  afterSalePhotosUploaded        AfterSalePhoto[]             @relation("AfterSalePhotoUploadedBy")
  afterSaleCostsRecorded         AfterSaleCostEntry[]         @relation("AfterSaleCostRecordedBy")
  afterSaleCostsReversed         AfterSaleCostEntry[]         @relation("AfterSaleCostReversedBy")
  penalties                      Penalty[]                    @relation("PenaltyWorker")
  penaltiesCreated               Penalty[]                    @relation("PenaltyCreatedBy")
  salesCommissionRules           SalesCommissionRule[]        @relation("SalesCommissionRuleCreatedBy")
  salesCommissionLogs            SalesCommissionLog[]         @relation("SalesCommissionSalesUser")
  createdSalesCommissions        SalesCommissionLog[]         @relation("SalesCommissionCreatedBy")
  workerCommissions              WorkerCommission[]           @relation("WorkerCommissionWorker")
  createdWorkerCommissions       WorkerCommission[]           @relation("WorkerCommissionCreatedBy")
  expenseApplications            ExpenseApplication[]         @relation("ExpenseApplicant")
  reviewedExpenses               ExpenseApplication[]         @relation("ExpenseReviewedBy")
  reimbursementApplications      ReimbursementApplication[]   @relation("ReimbursementApplicant")
  reviewedReimbursements         ReimbursementApplication[]   @relation("ReimbursementReviewedBy")
  paymentRecords                 PaymentRecord[]              @relation("PaymentRecordCreatedBy")
  financeApprovalRecords         FinanceApprovalRecord[]      @relation("FinanceApprovalOperator")
  financeAttachments             FinanceAttachment[]          @relation("FinanceAttachmentUploader")
  invoicesApplied                Invoice[]                    @relation("InvoiceAppliedBy")
  invoicesHandled                InvoiceLog[]                 @relation("InvoiceLogCreatedBy")
  rebatesApplied                 CustomerRebate[]             @relation("RebateAppliedBy")
  rebatesHandled                 RebateLog[]                  @relation("RebateLogCreatedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

