  role        String?
  isPrimary   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  supplier  Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  createdBy User     @relation("SupplierContactCreatedBy", fields: [createdById], references: [id])

  @@index([supplierId, isActive])
  @@index([createdById])
}

model SupplierRatingHistory {
  id          String   @id @default(cuid())
  supplierId  String
  rating      Int
  note        String?
  createdById String
  createdAt   DateTime @default(now())

  supplier  Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  createdBy User     @relation("SupplierRatingCreatedBy", fields: [createdById], references: [id])

  @@index([supplierId, createdAt])
  @@index([createdById])
}

model Warranty {
  id          String         @id @default(cuid())
  storeId     String
  orderId     String         @unique
  customerId  String
  vehicleId   String?
  warrantyNo  String         @unique
