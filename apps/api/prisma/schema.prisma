model InvoiceLog {
  id          String        @id @default(cuid())
  invoiceId   String
  status      InvoiceStatus
  note        String?
  createdById String
  createdAt   DateTime      @default(now())

  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdBy User    @relation("InvoiceLogCreatedBy", fields: [createdById], references: [id])

  @@index([invoiceId])
  @@index([createdById])
}

model CustomerRebate {
  id          String       @id @default(cuid())
  storeId     String
  orderId     String
  amountCents Int
  reason      String
  status      RebateStatus @default(APPLIED)
  appliedById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  store     Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order     Order       @relation(fields: [orderId], references: [id])
  appliedBy User        @relation("RebateAppliedBy", fields: [appliedById], references: [id])
  logs      RebateLog[]

  @@index([storeId, status])
  @@index([orderId])
}

model RebateLog {
  id          String       @id @default(cuid())
  rebateId    String
  status      RebateStatus
  note        String?
  createdById String
  createdAt   DateTime     @default(now())

  rebate    CustomerRebate @relation(fields: [rebateId], references: [id], onDelete: Cascade)
  createdBy User           @relation("RebateLogCreatedBy", fields: [createdById], references: [id])

  @@index([rebateId])
  @@index([createdById])
}

// 一个用户同一时间只能属于一家门店（数据库层强制）
// 冻结期间员工可接受其他门店邀请，接受时系统自动删除其在冻结门店的 StoreMember 记录
model StoreMember {
  id       String        @id @default(cuid())
  storeId  String
  userId   String
  position StorePosition

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, userId]) // 同一门店内每个用户只能有一个岗位
  @@unique([userId]) // 一个用户只能属于一家门店
}

// ─── Store Invitations ───────────────────────────────────────────────────────

enum InvitationStatus {
  PENDING // 待处理
  ACCEPTED // 已接受
  REJECTED // 已拒绝
  CANCELLED // 已撤销（店长主动取消）
}

model StoreInvitation {
  id            String           @id @default(cuid())
  storeId       String
  invitedById   String
  invitedUserId String
  position      StorePosition // 邀请加入后的岗位（不含 MANAGER）
  status        InvitationStatus @default(PENDING)

  store       Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  invitedBy   User  @relation("InvitedBy", fields: [invitedById], references: [id])
  invitedUser User  @relation("InvitedUser", fields: [invitedUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invitedUserId])
  @@index([storeId])
}

// ─── Notifications ───────────────────────────────────────────────────────────

enum NotificationType {
  STORE_INVITATION // 收到门店邀请
  INVITATION_ACCEPTED // 邀请被接受
  INVITATION_REJECTED // 邀请被拒绝
  AUDIT_APPROVED // 送审通过
  AUDIT_REJECTED // 送审驳回（含驳回原因）
  STORE_FROZEN // 门店被冻结
  STORE_UNFROZEN // 门店解冻
  REMOVED_FROM_STORE // 被移出门店（开除或店长变更）
  PASSWORD_RESET // 密码被审核员重置
}

model Notification {
  id      String           @id @default(cuid())
  userId  String
  type    NotificationType
  payload Json // 各类型自定义的附加数据，例如 storeId、storeName、reviewNote 等
  isRead  Boolean          @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt(sort: Desc)])
}

// ─── Audit Events ───────────────────────────────────────────────────────────

model AuditEvent {
  id         String  @id @default(cuid())
  action     String
  actorId    String?
  storeId    String?
  targetType String
  targetId   String?
  metadata   Json    @default("{}")

  createdAt DateTime @default(now())

  @@index([storeId, createdAt(sort: Desc)])
  @@index([targetType, targetId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([action])
}
