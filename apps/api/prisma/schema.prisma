/// Completeness of the server-side internal cost snapshot. A missing value is
/// intentionally different from zero: zero is a valid cost, missing means the
/// system must not present a reliable margin.
enum CostCompleteness {
  COMPLETE
  TEMPORARY
  MISSING
}

enum PositionCostRateVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum ConstructionCostSettlementStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  SETTLED
}

enum ConstructionCostAdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
  SETTLED
}

/// Confirmed after-sales costs remain immutable. Corrections are recorded as
/// a separate reversal row so both operational and financial reports retain
/// the full history.
enum AfterSaleCostCategory {
  MATERIAL
  CONSTRUCTION_LABOR
  REFUND_COMPENSATION
  OUTSOURCE
  SUPPLIER_RECOVERY
}

enum AfterSaleCostDirection {
  EXPENSE
  RECOVERY
}

enum AfterSaleCostStatus {
  CONFIRMED
  REVERSED
}

enum SalesQuoteStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  EXPIRED
  CONVERTED
  WITHDRAWN
}

enum PricingApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PricingApprovalType {
  DEVIATION
  MARGIN
  MINIMUM_PRICE
  SPECIAL_APPROVAL
}

enum CapacityReservationSourceType {
  QUOTE
  ORDER
}

enum CapacityReservationStatus {
  HELD
  CONFIRMED
  RELEASED
  EXPIRED
}

enum StoreStatus {
  DRAFTED // 筹办中：审核员刚创建，店长尚未提交信息
  PENDING_REVIEW // 审核中：店长已提交，等待审核员审核
  PUBLISHED // 公开：审核通过，对外展示
  FROZEN // 冻结：暂停运营，不对外展示
}

enum CrossStoreTaskStatus {
  PENDING_ACCEPTANCE
  REJECTED
  ACCEPTED
  READY_TO_DISPATCH
  DISPATCHED
  IN_CONSTRUCTION
  PENDING_SOURCE_ACCEPTANCE
  COMPLETED
  CANCELLED
}

enum CrossStoreMaterialSupplyMode {
  EXECUTION_STORE
}

model FinancialEntity {
  id        String           @id @default(cuid())
  code      String           @unique
  name      String
  status    DictionaryStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  stores          Store[]
  productMappings CrossStoreProductMapping[]

  @@index([status])
}

model Store {
  id                 String             @id @default(cuid())
  status             StoreStatus        @default(DRAFTED)
  // A store must pass the published-rule, construction-standard and position-rate
  // precheck before it can use the new calculation path for formal orders.
  pricingRolloutMode PricingRolloutMode @default(LEGACY)

  // 当前对外展示的内容（审核通过后从 StoreAuditSubmission 同步过来）
  name                          String // 审核员创建时初始化，后续可通过审核更新
  address                       String?
  description                   String? // 最多 300 字，在应用层校验
  financialEntityId             String
  crossStoreConstructionEnabled Boolean @default(false)

  createdById     String?
  createdBy       User?           @relation("CreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  financialEntity FinancialEntity @relation(fields: [financialEntityId], references: [id])

  members                     StoreMember[]
  photos                      StorePhoto[]
  submissions                 StoreAuditSubmission[]
  invitations                 StoreInvitation[]
  customers                   Customer[]
  customerVehicles            CustomerVehicle[]
  vehicleOwnershipHistory     VehicleOwnershipHistory[]
  customerStatements          CustomerStatement[]
  customerReceipts            CustomerReceipt[]
  products                    Product[]
  orders                      Order[]                      @relation("OrderSourceStore")
  executionOrders             Order[]                      @relation("OrderExecutionStore")
  crossStoreTasksAsSource     CrossStoreConstructionTask[] @relation("CrossStoreTaskSourceStore")
  crossStoreTasksAsExecution  CrossStoreConstructionTask[] @relation("CrossStoreTaskExecutionStore")
  crossStoreProductMappings   CrossStoreProductMapping[]   @relation("CrossStoreMappingExecutionStore")
  orderAmendmentRequests      OrderAmendmentRequest[]
  paymentAccounts             PaymentAccount[]
  dailyCapacities             DailyCapacity[]
  constructionWorkerProfiles  ConstructionWorkerProfile[]
  constructionRecords         ConstructionRecord[]
  constructionQualityHistory  ConstructionQualityHistory[]
  leaveRequests               LeaveRequest[]
  schedules                   Schedule[]
  inventoryBatches            InventoryBatch[]
  inventoryMovements          InventoryMovement[]
  warehouses                  Warehouse[]
  inventoryAllocations        OrderInventoryAllocation[]
  purchaseRequirements        PurchaseRequirement[]
  purchaseOrders              PurchaseOrder[]
  suppliers                   Supplier[]
  warranties                  Warranty[]
  afterSales                  AfterSale[]
  afterSaleCostEntries        AfterSaleCostEntry[]
  salesCommissionRules        SalesCommissionRule[]
  salesCommissionLogs         SalesCommissionLog[]
  workerCommissions           WorkerCommission[]
  expenseApplications         ExpenseApplication[]
  reimbursementApplications   ReimbursementApplication[]
  paymentRecords              PaymentRecord[]
  financeApprovalRecords      FinanceApprovalRecord[]
  financeAttachments          FinanceAttachment[]
  invoices                    Invoice[]
  customerRebates             CustomerRebate[]
  dictionaries                Dictionary[]
  pricingRuleSets             PricingRuleSet[]
  vehiclePriceClasses         VehiclePriceClass[]
  vehicleModelMappings        VehicleModelMapping[]
  pricingCalculations         PricingCalculation[]
  salesQuotes                 SalesQuote[]                 @relation("SalesQuoteSourceStore")
  executionSalesQuotes        SalesQuote[]                 @relation("SalesQuoteExecutionStore")
  capacityReservations        CapacityReservation[]
  constructionServiceItems    ConstructionServiceItem[]
  positionCostRateVersions    PositionCostRateVersion[]
  constructionCostSettlements ConstructionCostSettlement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
  @@index([status])
  @@index([financialEntityId, crossStoreConstructionEnabled])
}

model Dictionary {
  id                String           @id @default(cuid())
  storeId           String
  name              String
  code              String
  items             Json
  status            DictionaryStatus @default(ACTIVE)
  mode              DictionaryMode   @default(LEGACY)
  source            DictionarySource @default(STORE)
  allowCustomItems  Boolean          @default(true)
  allowDisableItems Boolean          @default(true)
  allowHierarchy    Boolean          @default(false)
  version           Int              @default(1)
  updatedById       String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  store           Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  dictionaryItems DictionaryItem[]

  @@unique([storeId, code])
  @@index([storeId, status])
}

model DictionaryItem {
  id             String           @id @default(cuid())
  dictionaryId   String
  code           String
  name           String
  description    String?
  sortOrder      Int              @default(0)
  status         DictionaryStatus @default(ACTIVE)
  isSystem       Boolean          @default(false)
  metadata       Json?
  parentId       String?
  source         DictionarySource @default(STORE)
  disabledReason String?
  usageCount     Int              @default(0)
  updatedById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  dictionary Dictionary       @relation(fields: [dictionaryId], references: [id], onDelete: Cascade)
  parent     DictionaryItem?  @relation("DictionaryItemHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children   DictionaryItem[] @relation("DictionaryItemHierarchy")

  @@unique([dictionaryId, code])
  @@index([dictionaryId, status, sortOrder])
  @@index([dictionaryId, parentId, status, sortOrder])
}

/// Global HQ dictionary templates. A null store scope is intentional: templates
/// are inherited by every store and are never edited through a store scope.
model DictionaryTemplate {
  id                String           @id @default(cuid())
  name              String
  code              String           @unique
  items             Json
  status            DictionaryStatus @default(ACTIVE)
  allowCustomItems  Boolean          @default(false)
  allowDisableItems Boolean          @default(true)
  allowHierarchy    Boolean          @default(false)
  version           Int              @default(1)
  updatedById       String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  templateItems DictionaryTemplateItem[]

  @@index([status, updatedAt])
}

model DictionaryTemplateItem {
  id             String           @id @default(cuid())
  templateId     String
  code           String
  name           String
  description    String?
  sortOrder      Int              @default(0)
  status         DictionaryStatus @default(ACTIVE)
  metadata       Json?
  parentId       String?
  disabledReason String?
  usageCount     Int              @default(0)
  updatedById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  template DictionaryTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  parent   DictionaryTemplateItem?  @relation("TemplateItemParent", fields: [parentId], references: [id], onDelete: SetNull)
  children DictionaryTemplateItem[] @relation("TemplateItemParent")

  @@unique([templateId, code])
  @@index([templateId, status, sortOrder])
  @@index([templateId, parentId, status, sortOrder])
}

/// Operational record for settings data migrations, including backup/checkpoint state.
model SettingsMigrationRun {
  id           String                     @id @default(cuid())
  runKey       String                     @unique
  status       SettingsMigrationRunStatus @default(RUNNING)
  backupFile   String?
  featureFlag  String
  checkpoint   Json                       @default("{}")
  summary      Json?
  errorMessage String?
  createdById  String?
  startedAt    DateTime                   @default(now())
  completedAt  DateTime?
  rolledBackAt DateTime?
  reviews      SettingsMigrationReview[]

  @@index([status, startedAt(sort: Desc)])
}

model SettingsMigrationReview {
  id           String                        @id @default(cuid())
  runId        String
  sourceType   String
  sourceId     String
  reason       String
  payload      Json                          @default("{}")
  status       SettingsMigrationReviewStatus @default(PENDING)
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime                      @default(now())
  run          SettingsMigrationRun          @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sourceType, sourceId])
  @@index([status, createdAt(sort: Desc)])
}

/// Versioned settings payloads. Published rows are immutable.
model SettingsConfigVersion {
  id               String               @id @default(cuid())
  domain           SettingsConfigDomain
  capabilityCode   String
  scopeId          String
  version          Int                  @default(1)
  status           SettingsConfigStatus @default(DRAFT)
  effectiveAt      DateTime?
  payload          Json
  validationErrors Json?
  createdById      String
  updatedById      String
  publishedById    String?
  publishedAt      DateTime?
  expiresAt        DateTime?
  requestId        String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([createdById, requestId])
  @@index([domain, scopeId, status])
  @@index([capabilityCode, scopeId, version])
  @@index([createdById, createdAt(sort: Desc)])
}

// 当前对外展示的门店照片（审核通过后从 StoreSubmissionPhoto 同步过来）
model StorePhoto {
  id      String  @id @default(cuid())
  storeId String
  url     String // 阿里云 OSS URL
  isCover Boolean @default(false) // 同一门店只有一张封面，由 partial unique index 保证
  order   Int     @default(0) // 展示顺序

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([storeId])
}

// ─── Store Audit ─────────────────────────────────────────────────────────────

enum SubmissionStatus {
  PENDING // 待审核
  APPROVED // 已通过
  REJECTED // 已驳回
}

// 每次店长提交送审时创建一条记录，同一时刻只有一条 PENDING（由 partial unique index 保证）
// 审核通过后将本条记录的内容同步到 Store 和 StorePhoto 表
model StoreAuditSubmission {
  id            String  @id @default(cuid())
  storeId       String
  submittedById String
  reviewedById  String?

  // 本次提交的内容快照
  name        String
  address     String?
  description String?
  photos      StoreSubmissionPhoto[]

  status     SubmissionStatus @default(PENDING)
  reviewNote String? // 驳回时审核员填写的原因
  reviewedAt DateTime?

  store       Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  submittedBy User  @relation("SubmittedBy", fields: [submittedById], references: [id])
  reviewedBy  User? @relation("ReviewedBy", fields: [reviewedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storeId])
  @@index([submittedById])
  @@index([status])
}

// 送审时提交的照片快照（审核通过后同步到 StorePhoto）
model StoreSubmissionPhoto {
  id           String  @id @default(cuid())
  submissionId String
  url          String // 阿里云 OSS URL（上传在送审前完成）
  isCover      Boolean @default(false) // 同一送审提交只有一张封面，由 partial unique index 保证
  order        Int     @default(0)

  submission StoreAuditSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([submissionId])
}

