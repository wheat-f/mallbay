enum AfterSalePhotoStage {
  ISSUE
  CONSTRUCTION_AFTER
  SUPPLEMENT
}

enum CommissionRuleType {
  FIXED_RATE
  FIXED_AMOUNT
  SALES_TIER
  CONSTRUCTION_TYPE
}

enum FinanceApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
  CANCELLED
}

enum PaymentRecordType {
  ORDER_PAYMENT
  CUSTOMER_RECEIPT
  CUSTOMER_RECEIPT_REVERSAL
  EXPENSE
  REIMBURSEMENT
  REBATE
  OTHER
  SUPPLIER_REFUND_OUT
  SUPPLIER_REFUND_REVERSAL
}

enum PaymentDirection {
  INCOME
  EXPENSE
  OUTFLOW
  INFLOW
}

enum FinanceApplicationType {
  EXPENSE
  REIMBURSEMENT
}

enum FinanceApprovalNode {
  MANAGER_REVIEW
  FINANCE_REVIEW
  PAYMENT
}

enum FinanceApprovalAction {
  SUBMITTED
  APPROVED
  REJECTED
  WITHDRAWN
  RESUBMITTED
  PAID
}

enum FinanceAttachmentCategory {
  INVOICE
  CONTRACT
  PAYMENT_PROOF
  OTHER
}

enum InvoiceStatus {
  APPLIED
  ISSUED
  VOIDED
  REISSUED
}

enum RebateStatus {
  APPLIED
  REVIEWED
  APPROVED
  REJECTED
  PAID
}

enum CustomerNoteType {
  PREFERENCE
  REQUIREMENT
  COMMUNICATION
}

model Customer {
  id             String              @id @default(cuid())
  storeId        String
  ownerUserId    String
  customerType   CustomerType
  name           String?
  gender         Gender?
  birthday       DateTime?
  companyName    String?
  contactPerson  String?
  phoneEncrypted String
  phoneHash      String
  wechat         String?
  sourceType     CustomerSourceType?
  sourceDetail   String?
  referrerId     String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  store              Store                     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  owner              User                      @relation("CustomerOwner", fields: [ownerUserId], references: [id])
  referrer           Customer?                 @relation("CustomerReferrals", fields: [referrerId], references: [id])
  referrals          Customer[]                @relation("CustomerReferrals")
  vehicles           CustomerVehicle[]
  users              CustomerUser[]
  notes              CustomerNote[]
  tags               CustomerTag[]
  orders             Order[]
  warranties         Warranty[]
  afterSales         AfterSale[]
  salesQuotes        SalesQuote[]
  statements         CustomerStatement[]
  receipts           CustomerReceipt[]
  invoices           Invoice[]
  vehicleHistoryFrom VehicleOwnershipHistory[] @relation("VehicleHistoryFromCustomer")
  vehicleHistoryTo   VehicleOwnershipHistory[] @relation("VehicleHistoryToCustomer")

  @@unique([storeId, phoneHash])
  @@index([storeId, ownerUserId])
  @@index([storeId, name])
  @@index([storeId, companyName])
}

model CustomerUser {
  id             String              @id @default(cuid())
  customerId     String
  name           String
  phoneEncrypted String?
  phoneHash      String?
  note           String?
  role           CustomerContactRole @default(OTHER)
  department     String?
  isDefault      Boolean             @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  customer              Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  defaultVehicles       CustomerVehicle[]      @relation("VehicleDefaultContact")
  orderContactSnapshots OrderContactSnapshot[]

  @@unique([customerId, phoneHash])
  @@index([customerId])
}

model CustomerVehicle {
  id                 String                @id @default(cuid())
  storeId            String
  customerId         String
  carPlate           String?
  carPlateNormalized String?
  vinEncrypted       String?
  vinHash            String?
  carModel           String
  carColor           String?
  photoUrl           String?
  /// System dictionary code from VEHICLE_TYPE. Historical vehicles may remain
  /// unset until the next quote/order asks the user to classify them.
  vehicleTypeCode    String?
  status             CustomerVehicleStatus @default(ACTIVE)
  defaultContactId   String?
  department         String?
  disabledAt         DateTime?
  disabledById       String?
  disabledReason     String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  store               Store                     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer            Customer                  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  defaultContact      CustomerUser?             @relation("VehicleDefaultContact", fields: [defaultContactId], references: [id], onDelete: SetNull)
  disabledBy          User?                     @relation("VehicleDisabledBy", fields: [disabledById], references: [id], onDelete: SetNull)
  ownershipHistory    VehicleOwnershipHistory[]
  orders              Order[]
  warranties          Warranty[]
  salesQuotes         SalesQuote[]
  vehiclePriceClassId String?
  vehiclePriceClass   VehiclePriceClass?        @relation(fields: [vehiclePriceClassId], references: [id], onDelete: SetNull)

  @@unique([storeId, carPlateNormalized])
  @@unique([storeId, vinHash])
  @@index([customerId, status])
  @@index([carPlate])
  @@index([vinHash])
  @@index([vehiclePriceClassId])
  @@index([vehicleTypeCode])
  @@index([defaultContactId])
  @@index([disabledById])
}

model VehicleOwnershipHistory {
  id             String              @id @default(cuid())
  storeId        String
  vehicleId      String
  fromCustomerId String?
  toCustomerId   String
  action         VehicleChangeAction
  beforeSnapshot Json?
  afterSnapshot  Json?
  reason         String?
  operatedById   String
  operatedAt     DateTime            @default(now())

  store        Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  vehicle      CustomerVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  fromCustomer Customer?       @relation("VehicleHistoryFromCustomer", fields: [fromCustomerId], references: [id], onDelete: SetNull)
  toCustomer   Customer        @relation("VehicleHistoryToCustomer", fields: [toCustomerId], references: [id])
  operatedBy   User            @relation("VehicleChangeOperatedBy", fields: [operatedById], references: [id])

  @@index([vehicleId, operatedAt])
  @@index([storeId, operatedAt])
  @@index([fromCustomerId])
  @@index([toCustomerId])
}

model CustomerNote {
  id          String           @id @default(cuid())
  customerId  String
  createdById String
  noteType    CustomerNoteType @default(COMMUNICATION)
  content     String
  createdAt   DateTime         @default(now())

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdBy User     @relation("CustomerNoteCreatedBy", fields: [createdById], references: [id])

  @@index([customerId, noteType, createdAt])
}

model CustomerTag {
  id          String   @id @default(cuid())
  customerId  String
  label       String
  createdById String
  createdAt   DateTime @default(now())

  customer  Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdBy User     @relation("CustomerTagCreatedBy", fields: [createdById], references: [id])

  @@unique([customerId, label])
  @@index([customerId])
}

model Product {
  id                String          @id @default(cuid())
  storeId           String
  brand             String
  name              String
  model             String
  category          ProductCategory
  specification     String?
  unit              ProductUnit
  inventoryUnit     ProductUnit     @default(ROLL)
  salesUnit         ProductUnit     @default(ROLL)
  rollWidthMeters   Decimal?        @db.Decimal(8, 3)
  rollLengthMeters  Decimal?        @db.Decimal(8, 3)
  metersPerRoll     Decimal?        @db.Decimal(10, 3)
  quantityPrecision Int             @default(3)
  warrantyYears     Int?
  basePriceCents    Int
  standardCostCents Int?
  status            ProductStatus   @default(ACTIVE)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  store                       Store                       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderItems                  OrderItem[]
  inventoryBatches            InventoryBatch[]
  inventoryMovements          InventoryMovement[]
  inventoryAllocations        OrderInventoryAllocation[]
  purchaseRequirementItems    PurchaseRequirementItem[]
  purchaseOrderItems          PurchaseOrderItem[]
  salesQuoteItems             SalesQuoteItem[]
  unitSuggestedPrices         ProductUnitSuggestedPrice[]
  sourceCrossStoreMappings    CrossStoreProductMapping[]  @relation("CrossStoreSourceProduct")
  executionCrossStoreMappings CrossStoreProductMapping[]  @relation("CrossStoreExecutionProduct")

  @@unique([storeId, brand, model])
  @@index([storeId, category])
  @@index([storeId, status])
}

/// A product's default-unit suggested price remains Product.basePriceCents for
/// backward compatibility. This table stores explicit suggested-price
/// overrides for other selectable sales units, such as metre pricing for a
/// roll-priced product.
model ProductUnitSuggestedPrice {
  id                  String      @id @default(cuid())
  productId           String
  salesUnit           ProductUnit
  suggestedPriceCents Int
  isActive            Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, salesUnit])
  @@index([productId, isActive])
}

model CrossStoreProductMapping {
  id                     String           @id @default(cuid())
  financialEntityId      String
  sourceProductId        String
  executionStoreId       String
  executionProductId     String
  sourceSalesUnit        ProductUnit
  executionInventoryUnit ProductUnit
  conversionSnapshot     Json?
  status                 DictionaryStatus @default(ACTIVE)
  createdById            String
  updatedById            String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  financialEntity  FinancialEntity @relation(fields: [financialEntityId], references: [id], onDelete: Cascade)
  sourceProduct    Product         @relation("CrossStoreSourceProduct", fields: [sourceProductId], references: [id], onDelete: Cascade)
  executionStore   Store           @relation("CrossStoreMappingExecutionStore", fields: [executionStoreId], references: [id], onDelete: Cascade)
  executionProduct Product         @relation("CrossStoreExecutionProduct", fields: [executionProductId], references: [id], onDelete: Cascade)

  @@unique([sourceProductId, executionStoreId])
  @@index([financialEntityId, status])
  @@index([executionStoreId, status])
  @@index([executionProductId])
}

model VehiclePriceClass {
  id          String           @id @default(cuid())
  storeId     String
  code        String
  name        String
  description String?
  sortOrder   Int              @default(0)
  isDefault   Boolean          @default(false)
  status      DictionaryStatus @default(ACTIVE)
  createdById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  store                 Store                      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  vehicles              CustomerVehicle[]
  mappings              VehicleModelMapping[]
  constructionStandards ConstructionStandardLine[]
  createdBy             User?                      @relation("VehiclePriceClassCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([storeId, code])
  @@index([storeId, status])
}

model VehicleModelMapping {
  id                  String           @id @default(cuid())
  storeId             String
  brand               String?
  modelKeyword        String
  yearFrom            Int?
  yearTo              Int?
  vehiclePriceClassId String
  priority            Int              @default(0)
  status              DictionaryStatus @default(ACTIVE)
  createdById         String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  store             Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  vehiclePriceClass VehiclePriceClass @relation(fields: [vehiclePriceClassId], references: [id], onDelete: Cascade)
  createdBy         User?             @relation("VehicleModelMappingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([storeId, status, priority])
  @@index([vehiclePriceClassId])
}

model PricingRuleSet {
  id                        String               @id @default(cuid())
  storeId                   String
  version                   Int
  status                    PricingRuleSetStatus @default(DRAFT)
  effectiveFrom             DateTime
  effectiveTo               DateTime?
  createdById               String
  publishedById             String?
  publishedAt               DateTime?
  sourceTemplateVersionId   String?
  positionCostRateVersionId String?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  store                   Store                      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  rules                   PricingRule[]
  protectionPolicy        PricingProtectionPolicy?
  calculations            PricingCalculation[]
  constructionStandards   ConstructionStandardLine[]
  positionCostRateVersion PositionCostRateVersion?   @relation(fields: [positionCostRateVersionId], references: [id], onDelete: Restrict)
  createdBy               User                       @relation("PricingRuleSetCreatedBy", fields: [createdById], references: [id])
  publishedBy             User?                      @relation("PricingRuleSetPublishedBy", fields: [publishedById], references: [id])

  @@unique([storeId, version])
  @@index([storeId, status, effectiveFrom])
  @@index([positionCostRateVersionId])
}

/// Store master data for a customer-facing construction service. It has richer
/// attributes than a dictionary item and can be selected by pricing standards.
model ConstructionServiceItem {
  id                         String           @id @default(cuid())
  storeId                    String
  code                       String
  name                       String
  constructionTypeCode       String
  serviceGroupCode           String
  defaultProductCategoryCode String?
  status                     DictionaryStatus @default(ACTIVE)
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt

  store                 Store                      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  constructionStandards ConstructionStandardLine[]

  @@unique([storeId, code])
  @@index([storeId, status, serviceGroupCode])
}

/// Finance-owned rate card. A pricing rule set points to one immutable
/// published version, so later personnel cost changes never rewrite history.
model PositionCostRateVersion {
  id            String                        @id @default(cuid())
  storeId       String
  version       Int
  status        PositionCostRateVersionStatus @default(DRAFT)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdById   String
  publishedById String?
  publishedAt   DateTime?
  createdAt     DateTime                      @default(now())
  updatedAt     DateTime                      @updatedAt

  store           Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  rates           PositionCostRate[]
  pricingRuleSets PricingRuleSet[]

  @@unique([storeId, version])
  @@index([storeId, status, effectiveFrom])
}

model PositionCostRate {
  id               String   @id @default(cuid())
  versionId        String
  positionTypeCode String
  hourlyCostCents  Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  version PositionCostRateVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, positionTypeCode])
}

/// Part of a PricingRuleSet to ensure customer charge, workload and cost
/// references are drafted, simulated and published together.
model ConstructionStandardLine {
  id                          String   @id @default(cuid())
  ruleSetId                   String
  serviceItemId               String
  vehiclePriceClassId         String?
  constructionLocationCode    String
  productCategoryCode         String?
  salesUnitCode               String?
  quantityFrom                Decimal? @db.Decimal(12, 3)
  quantityTo                  Decimal? @db.Decimal(12, 3)
  baseConstructionChargeCents Int
  standardWorkMinutes         Int
  addonChargeCents            Int      @default(0)
  addonWorkMinutes            Int      @default(0)
  standardCommissionCents     Int      @default(0)
  standardAllowanceCents      Int      @default(0)
  priority                    Int      @default(0)
  enabled                     Boolean  @default(true)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  ruleSet           PricingRuleSet                 @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)
  serviceItem       ConstructionServiceItem        @relation(fields: [serviceItemId], references: [id], onDelete: Restrict)
  vehiclePriceClass VehiclePriceClass?             @relation(fields: [vehiclePriceClassId], references: [id], onDelete: SetNull)
  crewRoles         ConstructionStandardCrewRole[]

  @@index([ruleSetId, enabled, priority])
  @@index([serviceItemId])
}

model ConstructionStandardCrewRole {
  id               String   @id @default(cuid())
  standardLineId   String
  positionTypeCode String
  workerCount      Int
  workMinutes      Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  standardLine ConstructionStandardLine @relation(fields: [standardLineId], references: [id], onDelete: Cascade)

  @@unique([standardLineId, positionTypeCode])
}

model PricingRuleTemplate {
  id          String                @id @default(cuid())
  code        String                @unique
  name        String
  description String?
  status      PricingTemplateStatus @default(DRAFT)
  createdById String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  createdBy User                         @relation("PricingRuleTemplateCreatedBy", fields: [createdById], references: [id])
  versions  PricingRuleTemplateVersion[]

  @@index([status, updatedAt])
}

model PricingRuleTemplateVersion {
  id               String    @id @default(cuid())
  templateId       String
  version          Int
  rules            Json
  protectionPolicy Json
  createdById      String
  publishedById    String?
  publishedAt      DateTime?
  createdAt        DateTime  @default(now())

  template    PricingRuleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  createdBy   User                @relation("PricingRuleTemplateVersionCreatedBy", fields: [createdById], references: [id])
  publishedBy User?               @relation("PricingRuleTemplateVersionPublishedBy", fields: [publishedById], references: [id])

  @@unique([templateId, version])
  @@index([templateId, publishedAt])
}

model PricingRule {
  id          String                @id @default(cuid())
  ruleSetId   String
  group       PricingRuleGroup
  target      PricingRuleTarget
  name        String
  conditions  Json
  actionType  PricingRuleActionType
  actionValue Int
  priority    Int                   @default(0)
  sortOrder   Int                   @default(0)
  enabled     Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  ruleSet PricingRuleSet @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)

  @@index([ruleSetId, group, target, enabled])
}

model PricingProtectionPolicy {
  id                      String   @id @default(cuid())
  ruleSetId               String   @unique
  normalDeviationBps      Int
  approvalDeviationBps    Int
  minimumMarginBps        Int
  blockBelowMarginBps     Int?
  softHoldHours           Int      @default(24)
  allowSpecialApproval    Boolean  @default(false)
  internalLaborCostConfig Json
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  ruleSet PricingRuleSet @relation(fields: [ruleSetId], references: [id], onDelete: Cascade)
}

model PricingCalculation {
  id                             String                     @id @default(cuid())
  storeId                        String
  ruleSetId                      String
  ruleSetVersion                 Int
  inputHash                      String
  inputSnapshot                  Json
  outputSnapshot                 Json
  appliedRules                   Json
  decision                       PricingCalculationDecision @default(NORMAL)
  estimatedMaterialCostCents     Int?
  estimatedConstructionCostCents Int?
  estimatedTotalCostCents        Int?
  costCompleteness               CostCompleteness?
  createdById                    String
  expiresAt                      DateTime?
  createdAt                      DateTime                   @default(now())

  store       Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  ruleSet     PricingRuleSet @relation(fields: [ruleSetId], references: [id], onDelete: Restrict)
  createdBy   User           @relation("PricingCalculationCreatedBy", fields: [createdById], references: [id])
  salesQuotes SalesQuote[]

  @@index([storeId, createdAt])
  @@index([ruleSetId, inputHash])
}

model SalesQuote {
  id                               String            @id @default(cuid())
  storeId                          String
  executionStoreId                 String
  quoteNo                          String            @unique
  customerId                       String
  vehicleId                        String?
  salesPersonId                    String
  pricingCalculationId             String
  status                           SalesQuoteStatus  @default(DRAFT)
  vehicleClassSnapshot             Json?
  suggestedProductAmountCents      Int
  suggestedLaborCostCents          Int
  suggestedTotalCents              Int
  finalProductAmountCents          Int
  finalLaborCostCents              Int
  finalTotalCents                  Int
  estimatedCostCents               Int?
  /// New explicit fields coexist with the legacy *LaborCost* fields until the
  /// API and historical exports have completed their compatibility window.
  suggestedConstructionChargeCents Int?
  finalConstructionChargeCents     Int?
  estimatedMaterialCostCents       Int?
  estimatedConstructionCostCents   Int?
  estimatedTotalCostCents          Int?
  costCompleteness                 CostCompleteness?
  temporaryCostCents               Int?
  temporaryCostReason              String?
  estimatedMarginBps               Int?
  adjustmentReasonCode             String?
  adjustmentReasonText             String?
  validUntil                       DateTime
  approvedAt                       DateTime?
  convertedOrderId                 String?           @unique
  appointmentDate                  DateTime?
  appointmentTimeSlot              String?
  constructionAddress              String?
  createdAt                        DateTime          @default(now())
  updatedAt                        DateTime          @updatedAt

  store               Store                @relation("SalesQuoteSourceStore", fields: [storeId], references: [id], onDelete: Cascade)
  executionStore      Store                @relation("SalesQuoteExecutionStore", fields: [executionStoreId], references: [id], onDelete: Restrict)
  customer            Customer             @relation(fields: [customerId], references: [id])
  vehicle             CustomerVehicle?     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  salesPerson         User                 @relation("SalesQuoteSalesPerson", fields: [salesPersonId], references: [id])
  pricingCalculation  PricingCalculation   @relation(fields: [pricingCalculationId], references: [id], onDelete: Restrict)
  convertedOrder      Order?               @relation(fields: [convertedOrderId], references: [id], onDelete: SetNull)
  items               SalesQuoteItem[]
  approvals           PricingApproval[]
  capacityReservation CapacityReservation?

  @@index([storeId, status, createdAt])
  @@index([executionStoreId, status, createdAt])
  @@index([customerId, createdAt])
  @@index([pricingCalculationId])
}

model SalesQuoteItem {
  id                      String      @id @default(cuid())
  quoteId                 String
  productId               String
  productSnapshot         Json
  quantity                Decimal     @db.Decimal(12, 3)
  salesUnit               ProductUnit
  basePriceCents          Int
  suggestedUnitPriceCents Int
  finalUnitPriceCents     Int
  suggestedAmountCents    Int
  finalAmountCents        Int
  minimumPriceCents       Int?
  calculationSnapshot     Json
  createdAt               DateTime    @default(now())

  quote   SalesQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product Product    @relation(fields: [productId], references: [id])

  @@index([quoteId])
  @@index([productId])
}

model PricingApproval {
  id            String                @id @default(cuid())
  quoteId       String
  status        PricingApprovalStatus @default(PENDING)
  approvalType  PricingApprovalType
  submittedById String
  reviewedById  String?
  reviewNote    String?
  submittedAt   DateTime              @default(now())
  reviewedAt    DateTime?

  quote       SalesQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  submittedBy User       @relation("PricingApprovalSubmittedBy", fields: [submittedById], references: [id])
  reviewedBy  User?      @relation("PricingApprovalReviewedBy", fields: [reviewedById], references: [id])

  @@index([quoteId, status])
  @@index([submittedById, submittedAt])
}

model CapacityReservation {
  id                   String                        @id @default(cuid())
  storeId              String
  dailyCapacityId      String
  date                 DateTime                      @db.Date
  constructionLocation ConstructionLocation
  constructionType     ConstructionType
  sourceType           CapacityReservationSourceType
  quoteId              String?                       @unique
  orderId              String?                       @unique
  status               CapacityReservationStatus     @default(HELD)
  expiresAt            DateTime?
  releasedReasonCode   String?
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt

  store         Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  dailyCapacity DailyCapacity @relation(fields: [dailyCapacityId], references: [id], onDelete: Cascade)
  quote         SalesQuote?   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  order         Order?        @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([storeId, date, status])
  @@index([expiresAt, status])
}

model Order {
  id                   String               @id @default(cuid())
  storeId              String
  executionStoreId     String
  orderNo              String               @unique
  customerId           String
  vehicleId            String?
  salesPersonId        String
  constructionType     ConstructionType
  constructionLocation ConstructionLocation
  constructionAddress  String?
  appointmentDate      DateTime?
  appointmentTimeSlot  String?
  status               OrderStatus          @default(PENDING_DISPATCH)
  remark               String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  store                      Store                               @relation("OrderSourceStore", fields: [storeId], references: [id], onDelete: Cascade)
  executionStore             Store                               @relation("OrderExecutionStore", fields: [executionStoreId], references: [id])
  customer                   Customer                            @relation(fields: [customerId], references: [id])
  vehicle                    CustomerVehicle?                    @relation(fields: [vehicleId], references: [id])
  salesPerson                User                                @relation("OrderSalesPerson", fields: [salesPersonId], references: [id])
  items                      OrderItem[]
  amount                     OrderAmount?
  payments                   OrderPayment[]
  constructionRecord         ConstructionRecord?
  constructionQualityHistory  ConstructionQualityHistory[]
  inventoryMovements         InventoryMovement[]
  inventoryAllocations       OrderInventoryAllocation[]
  purchaseRequirements       PurchaseRequirement[]
  warranty                   Warranty?
  afterSales                 AfterSale[]
  salesCommissionLog         SalesCommissionLog?
  workerCommissions          WorkerCommission[]
  invoices                   Invoice[]
  customerRebates            CustomerRebate[]
  salesQuote                 SalesQuote?
  capacityReservation        CapacityReservation?
  costSettlement             ConstructionCostSettlement?
  amendmentRequests          OrderAmendmentRequest[]
  contactSnapshot            OrderContactSnapshot?
  statementItems             CustomerStatementItem[]
  receiptReversalAllocations CustomerReceiptReversalAllocation[]
  invoiceAllocations         InvoiceOrderAllocation[]
  crossStoreTask             CrossStoreConstructionTask?

  @@index([storeId, status])
  @@index([executionStoreId, status])
  @@index([storeId, executionStoreId, appointmentDate])
  @@index([storeId, salesPersonId])
  @@index([customerId])
  @@index([vehicleId])
}

model CrossStoreConstructionTask {
  id                       String                       @id @default(cuid())
  orderId                  String                       @unique
  sourceStoreId            String
  executionStoreId         String
  status                   CrossStoreTaskStatus         @default(PENDING_ACCEPTANCE)
  materialSupplyMode       CrossStoreMaterialSupplyMode @default(EXECUTION_STORE)
  requirementsSnapshot     Json
  sourceContactSnapshot    Json?
  rejectionReason          String?
  cancellationReason       String?
  createdById              String
  acceptedById             String?
  sourceAcceptedById       String?
  cancelledById            String?
  acceptedAt               DateTime?
  dispatchedAt             DateTime?
  constructionStartedAt    DateTime?
  submittedForAcceptanceAt DateTime?
  completedAt              DateTime?
  cancelledAt              DateTime?
  version                  Int                          @default(1)
  createdAt                DateTime                     @default(now())
  updatedAt                DateTime                     @updatedAt

  order                Order                      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sourceStore          Store                      @relation("CrossStoreTaskSourceStore", fields: [sourceStoreId], references: [id])
  executionStore       Store                      @relation("CrossStoreTaskExecutionStore", fields: [executionStoreId], references: [id])
  inventoryMovements   InventoryMovement[]
  inventoryAllocations OrderInventoryAllocation[]
  purchaseRequirements PurchaseRequirement[]

  @@index([sourceStoreId, status, createdAt])
  @@index([executionStoreId, status, createdAt])
}

model OrderContactSnapshot {
  id                    String               @id @default(cuid())
  orderId               String               @unique
  sourceContactId       String?
  contactName           String
  contactPhoneEncrypted String?
  contactPhoneHash      String?
  role                  CustomerContactRole?
  department            String?
  createdAt             DateTime             @default(now())

  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sourceContact CustomerUser? @relation(fields: [sourceContactId], references: [id], onDelete: SetNull)

  @@index([sourceContactId])
}

model OrderItem {
  id                       String       @id @default(cuid())
  orderId                  String
  productId                String
  quantity                 Decimal      @db.Decimal(12, 3)
  salesUnit                ProductUnit?
  baseUnit                 ProductUnit?
  baseQuantityPerSalesUnit Decimal?     @db.Decimal(12, 3)
  requiredBaseQuantity     Decimal?     @db.Decimal(12, 3)
  unitPriceCents           Int
  amountCents              Int

  order                    Order                      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product                  Product                    @relation(fields: [productId], references: [id])
  inventoryAllocations     OrderInventoryAllocation[]
  purchaseRequirementItems PurchaseRequirementItem[]

  @@index([orderId])
}

model OrderAmount {
  id                                 String            @id @default(cuid())
  orderId                            String            @unique
  productAmountCents                 Int
  laborCostCents                     Int
  suggestedLaborCostCents            Int?
  laborCostAdjustmentReason          String?
  totalAmountCents                   Int
  paidAmountCents                    Int               @default(0)
  outstandingCents                   Int
  salesCommissionCents               Int               @default(0)
  materialCostCents                  Int               @default(0)
  profitCents                        Int               @default(0)
  pricingCalculationId               String?
  pricingRuleSetVersion              Int?
  pricingInputHash                   String?
  pricingOutputSnapshot              Json?
  /// Explicit customer-charge fields. Legacy laborCost* fields remain readable
  /// for historical orders and are backfilled during the additive migration.
  constructionChargeCents            Int?
  suggestedConstructionChargeCents   Int?
  constructionChargeAdjustmentReason String?
  estimatedMaterialCostCents         Int?
  estimatedConstructionCostCents     Int?
  estimatedTotalCostCents            Int?
  costCompleteness                   CostCompleteness?
  temporaryCostCents                 Int?
  temporaryCostReason                String?
  settlementDifferenceCents          Int               @default(0)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model PaymentAccount {
  id        String             @id @default(cuid())
  storeId   String
  name      String
  type      PaymentAccountType
  bankName  String?
  accountNo String?
  isDefault Boolean            @default(false)
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  store            Store                      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  payments         OrderPayment[]
  paymentRecords   PaymentRecord[]
  reimbursements   ReimbursementApplication[] @relation("ReimbursementPaymentAccount")
  customerReceipts CustomerReceipt[]

  @@index([storeId, isActive])
}

model OrderPayment {
  id                String      @id @default(cuid())
  orderId           String
  accountId         String
  paymentType       PaymentType
  amountCents       Int
  paidAt            DateTime
  createdById       String
  createdAt         DateTime    @default(now())
  customerReceiptId String?
  idempotencyKey    String?

  order               Order                               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  account             PaymentAccount                      @relation(fields: [accountId], references: [id])
  createdBy           User                                @relation("OrderPaymentCreatedBy", fields: [createdById], references: [id])
  customerReceipt     CustomerReceipt?                    @relation(fields: [customerReceiptId], references: [id], onDelete: SetNull)
  reversalAllocations CustomerReceiptReversalAllocation[]

  @@unique([orderId, idempotencyKey])
  @@index([orderId])
  @@index([accountId])
  @@index([customerReceiptId])
}

model CustomerStatement {
  id               String                  @id @default(cuid())
  storeId          String
  customerId       String
  statementNo      String                  @unique
  periodStart      DateTime
  periodEnd        DateTime
  receivableCents  Int
  receivedCents    Int
  outstandingCents Int
  status           CustomerStatementStatus @default(DRAFT)
  confirmedById    String?
  confirmedAt      DateTime?
  voidReason       String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  store       Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer    Customer                @relation(fields: [customerId], references: [id])
  confirmedBy User?                   @relation("CustomerStatementConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  items       CustomerStatementItem[]

  @@index([storeId, customerId, periodStart, periodEnd])
  @@index([storeId, status])
}

model CustomerStatementItem {
  id               String   @id @default(cuid())
  statementId      String
  orderId          String
  orderAmountCents Int
  paidAmountCents  Int
  outstandingCents Int
  createdAt        DateTime @default(now())

  statement CustomerStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  order     Order             @relation(fields: [orderId], references: [id])

  @@unique([statementId, orderId])
  @@index([orderId])
}

model CustomerReceipt {
  id             String                @id @default(cuid())
  storeId        String
  customerId     String
  accountId      String
  receiptNo      String                @unique
  amountCents    Int
  receivedAt     DateTime
  payerName      String?
  bankSerialNo   String?
  note           String?
  status         CustomerReceiptStatus @default(DRAFT)
  createdById    String
  postedById     String?
  postedAt       DateTime?
  reversedById   String?
  reversedAt     DateTime?
  reversedReason String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  idempotencyKey String?

  store       Store                     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer    Customer                  @relation(fields: [customerId], references: [id])
  account     PaymentAccount            @relation(fields: [accountId], references: [id])
  createdBy   User                      @relation("CustomerReceiptCreatedBy", fields: [createdById], references: [id])
  postedBy    User?                     @relation("CustomerReceiptPostedBy", fields: [postedById], references: [id], onDelete: SetNull)
  reversedBy  User?                     @relation("CustomerReceiptReversedBy", fields: [reversedById], references: [id], onDelete: SetNull)
  allocations OrderPayment[]
  reversals   CustomerReceiptReversal[]

  @@index([storeId, customerId, receivedAt])
  @@index([storeId, status])
  @@index([accountId])
  @@unique([storeId, idempotencyKey])
}

model CustomerReceiptReversal {
  id          String   @id @default(cuid())
  receiptId   String
  amountCents Int
  reason      String
  createdById String
  createdAt   DateTime @default(now())
  idempotencyKey String?

  receipt     CustomerReceipt                     @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  createdBy   User                                @relation("CustomerReceiptReversalCreatedBy", fields: [createdById], references: [id])
  allocations CustomerReceiptReversalAllocation[]

  @@index([receiptId, createdAt])
  @@index([createdById])
  @@unique([receiptId, idempotencyKey])
}

model CustomerReceiptReversalAllocation {
  id             String   @id @default(cuid())
  reversalId     String
  orderPaymentId String
  orderId        String
  amountCents    Int
  createdAt      DateTime @default(now())

  reversal     CustomerReceiptReversal @relation(fields: [reversalId], references: [id], onDelete: Cascade)
  orderPayment OrderPayment            @relation(fields: [orderPaymentId], references: [id], onDelete: Restrict)
  order        Order                   @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([reversalId, orderPaymentId])
  @@index([orderPaymentId])
  @@index([orderId])
}

model OrderAmendmentRequest {
  id            String               @id @default(cuid())
  storeId       String
  orderId       String
  status        OrderAmendmentStatus @default(PENDING)
  reason        String
  requestedById String
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNote    String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  store       Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order       Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestedBy User  @relation("OrderAmendmentRequestedBy", fields: [requestedById], references: [id])
  reviewedBy  User? @relation("OrderAmendmentReviewedBy", fields: [reviewedById], references: [id])

  @@index([orderId, status])
  @@index([storeId, status])
  @@index([requestedById])
}

// ─── Phase 2 Construction ───────────────────────────────────────────────────

model DailyCapacity {
  id                 String   @id @default(cuid())
  storeId            String
  date               DateTime @db.Date
  inStoreCapacity    Int      @default(0)
  inStoreReserved    Int      @default(0)
  outsideCapacity    Int      @default(0)
  outsideReserved    Int      @default(0)
  heatFilmCapacity   Int      @default(0)
  heatFilmReserved   Int      @default(0)
  inspectionCapacity Int      @default(0)
  inspectionReserved Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  store        Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  reservations CapacityReservation[]

  @@unique([storeId, date])
  @@index([storeId])
}

model ConstructionWorkerProfile {
  id             String           @id @default(cuid())
  storeId        String
  userId         String           @unique
  canWorkOutside Boolean          @default(false)
  skillTags      WorkerSkillTag[]
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([storeId, isActive])
}

model ConstructionRecord {
  id                        String                 @id @default(cuid())
  storeId                   String
  orderId                   String                 @unique
  status                    ConstructionTaskStatus @default(DISPATCHED)
  dispatchedById            String
  dispatchedAt              DateTime               @default(now())
  startedAt                 DateTime?
  completedAt               DateTime?
  actualMinutes             Int?
  overtimeMinutes           Int                    @default(0)
  qualityResult             QualityCheckResult?
  qualityNote               String?
  qualityCheckedById        String?
  qualityCheckedAt          DateTime?
  reworkCount               Int                    @default(0)
  currentReworkReason       String?
  currentResponsibilityType String?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  store               Store                       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order               Order                       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dispatchedBy        User                        @relation("ConstructionDispatchedBy", fields: [dispatchedById], references: [id])
  qualityCheckedBy    User?                       @relation("ConstructionQualityCheckedBy", fields: [qualityCheckedById], references: [id])
  assignments         ConstructionAssignment[]
  photos              ConstructionPhoto[]
  qualityHistory      ConstructionQualityHistory[]
  commissionSnapshots WorkerCommissionSnapshot[]
  workerCommissions   WorkerCommission[]
  costSettlement      ConstructionCostSettlement?

  @@index([storeId, status])
  @@index([dispatchedById])
}

/// Append-only quality facts. ConstructionRecord quality fields remain the
/// legacy/current snapshot used by existing consumers during migration.
model ConstructionQualityHistory {
  id                 String             @id @default(cuid())
  storeId            String
  recordId           String
  orderId            String
  result             QualityCheckResult
  note               String?
  responsibilityType String?
  checkedById        String
  checkedAt          DateTime           @default(now())
  isRevoked          Boolean            @default(false)
  revokedById        String?
  revokedAt          DateTime?
  revocationReason   String?
  createdAt          DateTime           @default(now())

  store      Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  record     ConstructionRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  order      Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  checkedBy  User               @relation("ConstructionQualityCheckedByHistory", fields: [checkedById], references: [id])
  revokedBy  User?              @relation("ConstructionQualityRevokedBy", fields: [revokedById], references: [id])

  @@index([recordId, checkedAt])
  @@index([storeId, checkedAt])
  @@index([orderId, checkedAt])
}

/// One cost settlement is created for each construction record. It is distinct
/// from task timing: standard work is the default, workers may declare a
/// variance, and a manager must confirm before financial settlement.
model ConstructionCostSettlement {
  id                             String                           @id @default(cuid())
  storeId                        String
  orderId                        String                           @unique
  constructionRecordId           String                           @unique
  status                         ConstructionCostSettlementStatus @default(PENDING_CONFIRMATION)
  standardWorkMinutes            Int
  declaredWorkMinutes            Int?
  confirmedWorkMinutes           Int
  estimatedMaterialCostCents     Int?
  estimatedConstructionCostCents Int?
  actualMaterialCostCents        Int                              @default(0)
  actualConstructionCostCents    Int                              @default(0)
  actualTotalCostCents           Int                              @default(0)
  actualGrossProfitCents         Int?
  actualGrossMarginBps           Int?
  sourceSnapshot                 Json
  confirmedById                  String?
  confirmedAt                    DateTime?
  settledById                    String?
  settledAt                      DateTime?
  createdAt                      DateTime                         @default(now())
  updatedAt                      DateTime                         @updatedAt

  store              Store                        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order              Order                        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  constructionRecord ConstructionRecord           @relation(fields: [constructionRecordId], references: [id], onDelete: Cascade)
  workerLines        ConstructionCostWorkerLine[]
  adjustments        ConstructionCostAdjustment[]
  exceptions         OrderCostException[]

  @@index([storeId, status, updatedAt])
}

model ConstructionCostWorkerLine {
  id                            String   @id @default(cuid())
  settlementId                  String
  workerUserId                  String
  positionTypeCode              String
  standardMinutes               Int
  declaredMinutes               Int?
  confirmedMinutes              Int
  hourlyCostCentsSnapshot       Int
  baseCostCents                 Int
  commissionCents               Int      @default(0)
  allowanceCents                Int      @default(0)
  /// 店长可在成本确认时逐人手工分配施工收费；为空时按确认工时比例分配。
  manualConstructionChargeCents Int?
  varianceReasonCode            String?
  varianceReasonText            String?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  settlement ConstructionCostSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  worker     User                       @relation(fields: [workerUserId], references: [id], onDelete: Restrict)

  @@unique([settlementId, workerUserId])
  @@index([workerUserId])
}

model ConstructionCostAdjustment {
  id             String                           @id @default(cuid())
  settlementId   String
  idempotencyKey String?
  adjustmentType String
  amountCents    Int
  reasonCode     String
  reasonText     String?
  status         ConstructionCostAdjustmentStatus @default(PENDING)
  requestedById  String
  approvedById   String?
  approvedAt     DateTime?
  settledAt      DateTime?
  createdAt      DateTime                         @default(now())
  updatedAt      DateTime                         @updatedAt

  settlement ConstructionCostSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@unique([settlementId, idempotencyKey])
  @@index([settlementId, status])
}

model OrderCostException {
  id            String   @id @default(cuid())
  settlementId  String
  exceptionType String
  expectedCents Int
  actualCents   Int
  varianceCents Int
  status        String   @default("OPEN")
  ownerId       String?
  resolution    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  settlement ConstructionCostSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@index([settlementId, status])
}

model ConstructionAssignment {
  id           String   @id @default(cuid())
  recordId     String
  orderId      String
  workerUserId String
  assignedAt   DateTime @default(now())

  record ConstructionRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  worker User               @relation("ConstructionAssignedWorker", fields: [workerUserId], references: [id], onDelete: Cascade)

  @@unique([orderId, workerUserId])
  @@index([recordId])
  @@index([workerUserId])
}

model ConstructionPhoto {
  id           String                 @id @default(cuid())
  recordId     String
  stage        ConstructionPhotoStage
  url          String
  uploadedById String
  takenAt      DateTime?
  createdAt    DateTime               @default(now())

  record         ConstructionRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  uploadedBy     User               @relation("ConstructionPhotoUploadedBy", fields: [uploadedById], references: [id])
  warrantyPhotos WarrantyPhoto[]

  @@index([recordId, stage])
  @@index([uploadedById])
}

model LeaveRequest {
  id           String             @id @default(cuid())
  storeId      String
  workerId     String
  startDate    DateTime           @db.Date
  endDate      DateTime           @db.Date
  leaveType    String?
  reason       String?
  status       LeaveRequestStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  store      Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  worker     User  @relation("LeaveRequestWorker", fields: [workerId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("LeaveRequestReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([storeId, startDate, endDate])
  @@index([workerId, status])
}

model Schedule {
  id        String         @id @default(cuid())
  storeId   String
  workerId  String
  date      DateTime       @db.Date
  status    ScheduleStatus @default(WORKING)
  note      String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  store  Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  worker User  @relation("ScheduleWorker", fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([workerId, date])
  @@index([storeId, date])
}

model WorkerCommissionSnapshot {
  id              String   @id @default(cuid())
  recordId        String
  orderId         String
  workerUserId    String
  amountCents     Int
  calculationNote String
  createdById     String
  createdAt       DateTime @default(now())

  record    ConstructionRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  worker    User               @relation("WorkerCommissionWorker", fields: [workerUserId], references: [id])
  createdBy User               @relation("WorkerCommissionCreatedBy", fields: [createdById], references: [id])

  @@unique([recordId, workerUserId])
  @@index([orderId])
  @@index([workerUserId])
}

// ─── Phase 3 Inventory, Purchase, Warranty ──────────────────────────────────

model Warehouse {
  id          String   @id @default(cuid())
  storeId     String
  name        String
  code        String?
  area        String?
  address     String?
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store              Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdBy          User                @relation("WarehouseCreatedBy", fields: [createdById], references: [id])
  inventoryBatches   InventoryBatch[]
  inventoryMovements InventoryMovement[]

  @@unique([storeId, name])
  @@index([storeId, isActive])
  @@index([createdById])
}

model InventoryBatch {
  id                     String          @id @default(cuid())
  storeId                String
  productId              String
  batchNo                String
  supplierName           String?
  unit                   ProductUnit     @default(ROLL)
  packageUnit            ProductUnit?
  packageQuantity        Decimal?        @db.Decimal(12, 3)
  baseUnit               ProductUnit     @default(PIECE)
  baseQuantityPerPackage Decimal?        @db.Decimal(12, 3)
  totalQuantity          Decimal         @db.Decimal(12, 3)
  availableQuantity      Decimal         @db.Decimal(12, 3)
  lockedQuantity         Decimal         @default(0) @db.Decimal(12, 3)
  outboundQuantity       Decimal         @default(0) @db.Decimal(12, 3)
  unitCostCents          Int?
  productionDate         DateTime?
  receivedAt             DateTime?
  warehouseId            String?
  warehouseName          String?
  parentBatchId          String?
  sourceType             String?
  sourceId               String?
  inventoryStatus        InventoryStatus @default(AVAILABLE)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  store              Store                       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product            Product                     @relation(fields: [productId], references: [id])
  warehouse          Warehouse?                  @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  parentBatch        InventoryBatch?             @relation("InventoryBatchSplit", fields: [parentBatchId], references: [id])
  childBatches       InventoryBatch[]            @relation("InventoryBatchSplit")
  movements          InventoryMovement[]
  allocations        OrderInventoryAllocation[]
  receiptCostRecords PurchaseReceiptCostRecord[]

  @@unique([storeId, productId, batchNo])
  @@index([storeId, productId])
  @@index([storeId, batchNo])
  @@index([warehouseId])
  @@index([parentBatchId])
}

model InventoryMovement {
  id               String                @id @default(cuid())
  storeId          String
  batchId          String
  productId        String
  orderId          String?
  crossStoreTaskId String?
  movementType     InventoryMovementType
  quantity         Decimal               @db.Decimal(12, 3)
  unit             ProductUnit?
  fromUnit         ProductUnit?
  toUnit           ProductUnit?
  conversionRate   Float?
  sourceType       String?
  sourceId         String?
  idempotencyKey   String?
  returnId         String?
  sourceDetailId   String?
  note             String?
  warehouseId      String?
  warehouseName    String?
  createdById      String
  createdAt        DateTime              @default(now())

  store          Store                       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  batch          InventoryBatch              @relation(fields: [batchId], references: [id], onDelete: Cascade)
  product        Product                     @relation(fields: [productId], references: [id])
  order          Order?                      @relation(fields: [orderId], references: [id])
  crossStoreTask CrossStoreConstructionTask? @relation(fields: [crossStoreTaskId], references: [id], onDelete: SetNull)
  warehouse      Warehouse?                  @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  createdBy      User                        @relation("InventoryMovementCreatedBy", fields: [createdById], references: [id])

  @@index([storeId, createdAt])
  @@index([orderId])
  @@index([crossStoreTaskId])
  @@index([batchId])
  @@index([productId])
  @@index([warehouseId])
  @@index([sourceType, sourceId])
  @@unique([storeId, sourceType, sourceId, idempotencyKey])
}

model OrderInventoryAllocation {
  id               String                    @id @default(cuid())
  storeId          String
  orderId          String
  crossStoreTaskId String?
  orderItemId      String
  productId        String
  batchId          String
  lockedQuantity   Decimal                   @db.Decimal(12, 3)
  outboundQuantity Decimal                   @default(0) @db.Decimal(12, 3)
  status           InventoryAllocationStatus @default(LOCKED)
  lockedById       String
  lockedAt         DateTime                  @default(now())
  outboundById     String?
  outboundAt       DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  store          Store                       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order          Order                       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  crossStoreTask CrossStoreConstructionTask? @relation(fields: [crossStoreTaskId], references: [id], onDelete: SetNull)
  orderItem      OrderItem                   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  product        Product                     @relation(fields: [productId], references: [id])
  batch          InventoryBatch              @relation(fields: [batchId], references: [id], onDelete: Cascade)
  lockedBy       User                        @relation("InventoryAllocationLockedBy", fields: [lockedById], references: [id])
  outboundBy     User?                       @relation("InventoryAllocationOutboundBy", fields: [outboundById], references: [id])

  @@unique([orderId, orderItemId, batchId])
  @@index([storeId, status])
  @@index([orderId])
  @@index([crossStoreTaskId])
  @@index([batchId])
  @@index([lockedById])
  @@index([outboundById])
}

model PurchaseRequirement {
  id               String                    @id @default(cuid())
  storeId          String
  sourceOrderId    String?
  crossStoreTaskId String?
  status           PurchaseRequirementStatus @default(OPEN)
  createdById      String
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  store          Store                       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  sourceOrder    Order?                      @relation(fields: [sourceOrderId], references: [id], onDelete: SetNull)
  crossStoreTask CrossStoreConstructionTask? @relation(fields: [crossStoreTaskId], references: [id], onDelete: SetNull)
  createdBy      User                        @relation("PurchaseRequirementCreatedBy", fields: [createdById], references: [id])
  items          PurchaseRequirementItem[]
  purchaseOrders PurchaseOrder[]

  @@index([storeId, status])
  @@index([sourceOrderId])
  @@index([crossStoreTaskId])
  @@index([createdById])
}

model PurchaseRequirementItem {
  id                    String      @id @default(cuid())
  purchaseRequirementId String
  productId             String
  orderItemId           String?
  requiredQuantity      Decimal     @db.Decimal(12, 3)
  requiredUnit          ProductUnit
  fulfilledQuantity     Decimal     @default(0) @db.Decimal(12, 3)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  purchaseRequirement PurchaseRequirement @relation(fields: [purchaseRequirementId], references: [id], onDelete: Cascade)
  product             Product             @relation(fields: [productId], references: [id])
  orderItem           OrderItem?          @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  purchaseOrderItems  PurchaseOrderItem[]

  @@index([purchaseRequirementId])
  @@index([productId])
  @@index([orderItemId])
}

model PurchaseOrder {
  id                    String              @id @default(cuid())
  storeId               String
  purchaseRequirementId String?
  orderNo               String              @unique
  supplierName          String?
  status                PurchaseOrderStatus @default(DRAFT)
  expectedAt            DateTime?
  createdById           String
  purchaserId           String
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  store               Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  purchaseRequirement PurchaseRequirement? @relation(fields: [purchaseRequirementId], references: [id], onDelete: SetNull)
  createdBy           User                 @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id])
  purchaser           User                 @relation("PurchaseOrderPurchaser", fields: [purchaserId], references: [id])
  items               PurchaseOrderItem[]

  @@index([storeId, status])
  @@index([purchaseRequirementId])
  @@index([createdById])
  @@index([storeId, purchaserId])
}

model PurchaseOrderItem {
  id                        String  @id @default(cuid())
  purchaseOrderId           String
  purchaseRequirementItemId String?
  productId                 String
  quantity                  Decimal @db.Decimal(12, 3)
  receivedQuantity          Decimal @default(0) @db.Decimal(12, 3)
  unitCostCents             Int?

  purchaseOrder           PurchaseOrder               @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  purchaseRequirementItem PurchaseRequirementItem?    @relation(fields: [purchaseRequirementItemId], references: [id], onDelete: SetNull)
  product                 Product                     @relation(fields: [productId], references: [id])
  receiptCostRecords      PurchaseReceiptCostRecord[]

  @@index([purchaseOrderId])
  @@index([purchaseRequirementItemId])
  @@index([productId])
}

model PurchaseReceiptCostRecord {
  id                   String      @id @default(cuid())
  storeId              String
  purchaseOrderItemId  String
  inventoryBatchId     String
  receivedQuantity     Decimal     @db.Decimal(12, 3)
  purchaseUnit         ProductUnit
  baseUnit             ProductUnit
  baseQuantity         Decimal     @db.Decimal(12, 3)
  plannedUnitCostCents Int?
  actualUnitCostCents  Int?
  baseUnitCostCents    Int?
  differenceCents      Int?
  differenceReason     String?
  createdById          String
  updatedById          String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  purchaseOrderItem PurchaseOrderItem @relation(fields: [purchaseOrderItemId], references: [id], onDelete: Cascade)
  inventoryBatch    InventoryBatch    @relation(fields: [inventoryBatchId], references: [id], onDelete: Cascade)

  @@index([storeId, createdAt])
  @@index([purchaseOrderItemId])
  @@index([inventoryBatchId])
}

model Supplier {
  id              String   @id @default(cuid())
  storeId         String
  name            String
  contactName     String?
  contactPhone    String?
  settlementCycle String?
  rating          Int?
  note            String?
  isActive        Boolean  @default(true)
