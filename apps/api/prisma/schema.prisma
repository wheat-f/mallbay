// 一个用户同一时间只能属于一家门店（数据库层强制）
// 冻结期间员工可接受其他门店邀请，接受时系统自动删除其在冻结门店的 StoreMember 记录
model StoreMember {
  id       String        @id @default(cuid())
  storeId  String
  userId   String
  position StorePosition

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storeId, userId]) // 同一门店内每个用户只能有一个岗位
  @@unique([userId]) // 一个用户只能属于一家门店
}

// ─── Store Invitations ───────────────────────────────────────────────────────

enum InvitationStatus {
  PENDING // 待处理
  ACCEPTED // 已接受
  REJECTED // 已拒绝
  CANCELLED // 已撤销（店长主动取消）
}

model StoreInvitation {
  id            String           @id @default(cuid())
  storeId       String
  invitedById   String
  invitedUserId String
  position      StorePosition // 邀请加入后的岗位（不含 MANAGER）
  status        InvitationStatus @default(PENDING)

  store       Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  invitedBy   User  @relation("InvitedBy", fields: [invitedById], references: [id])
  invitedUser User  @relation("InvitedUser", fields: [invitedUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([invitedUserId])
  @@index([storeId])
}

// ─── Notifications ───────────────────────────────────────────────────────────

enum NotificationType {
  SETTINGS_CONFIG_EXPIRING // 系统设置草稿即将过期
  STORE_INVITATION // 收到门店邀请
  INVITATION_ACCEPTED // 邀请被接受
  INVITATION_REJECTED // 邀请被拒绝
  AUDIT_APPROVED // 送审通过
  AUDIT_REJECTED // 送审驳回（含驳回原因）
  STORE_FROZEN // 门店被冻结
  STORE_UNFROZEN // 门店解冻
  REMOVED_FROM_STORE // 被移出门店（开除或店长变更）
  PASSWORD_RESET // 密码被审核员重置
  LEAVE_APPROVAL_REQUIRED // 施工请假待审批
  LEAVE_APPROVED // 施工请假已批准
  LEAVE_REJECTED // 施工请假已驳回
  CROSS_STORE_TASK_CREATED // 来源门店发起跨门店施工协作
  CROSS_STORE_TASK_ACCEPTED // 执行门店已接单
  CROSS_STORE_TASK_REJECTED // 执行门店已拒单
  CROSS_STORE_TASK_READY // 协作任务已具备派工条件
  CROSS_STORE_TASK_SUBMITTED // 执行门店已提交来源门店验收
  CROSS_STORE_TASK_COMPLETED // 来源门店已完成验收
  CROSS_STORE_TASK_CANCELLED // 协作任务已取消
  ORDER_BALANCE_DUE // 订单尾款待收
}

model AuthSession {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String
  deviceName String    @default("未知设备")
  userAgent  String?
  ipAddress  String?
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, lastSeenAt(sort: Desc)])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  payload   Json // 各类型自定义的附加数据，例如 storeId、storeName、reviewNote 等
  isRead    Boolean          @default(false)
  todoKey   String?          @unique
  handledAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt(sort: Desc)])
}

// ─── Audit Events ───────────────────────────────────────────────────────────

model AuditEvent {
  id         String  @id @default(cuid())
  action     String
  actorId    String?
  storeId    String?
  targetType String
  targetId   String?
  idempotencyKey String?
  metadata   Json    @default("{}")

  createdAt DateTime @default(now())

  @@index([storeId, createdAt(sort: Desc)])
  @@index([targetType, targetId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([action])
  @@unique([action, targetType, targetId, idempotencyKey])
}

enum InventoryStatus {
  AVAILABLE
  INSPECTION
  DAMAGED
}

enum InspectionApprovalStatus {
  PENDING
  APPROVED
  EXECUTED
  REJECTED
}

enum CostVerificationStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

enum SalesReturnStatus {
  DRAFT
  SUBMITTED
  APPROVED
  WAITING_RECEIPT
  PARTIAL_RECEIVED
  WAITING_REFUND
  PARTIAL_REFUND
  REFUNDED
  CANCELLED
  PARTIAL_CANCELLED
  CLOSED
  REJECTED
}

enum PurchaseReturnStatus {
  DRAFT
  SUBMITTED
  APPROVED
  WAITING_OUTBOUND
  PARTIAL_OUTBOUND
  WAITING_SETTLEMENT
  PARTIAL_SETTLEMENT
  SETTLED
  CANCELLED
  PARTIAL_CANCELLED
  CLOSED
  REJECTED
}

enum ReturnMode {
  PHYSICAL_RETURN
  REFUND_ONLY
}

enum SettlementAdjustmentStatus {
  PENDING
  CONFIRMED
  REVERSED
}

model SalesReturn {
  id                   String            @id @default(cuid())
  storeId              String
  executionStoreId     String
  returnNo             String            @unique
  orderId              String
  afterSaleId          String?
  status               SalesReturnStatus @default(DRAFT)
  returnMode           ReturnMode        @default(PHYSICAL_RETURN)
  reason               String
  requestedRefundCents Int               @default(0)
  approvedRefundCents  Int?
  refundedAmountCents  Int               @default(0)
  actualRefundCents    Int?
  waivedRefundCents    Int               @default(0)
  remainingRefundCents Int               @default(0)
  waiverReason         String?
  refundMethod         String?
  voucherId            String?
  costAdjustmentId     String?
  refundedById         String?
  refundedAt           DateTime?
  cancelReason         String?
  closedAt             DateTime?
  createdById          String
  approvedById         String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([storeId, status, createdAt])
  @@index([executionStoreId, status, createdAt])
  @@index([orderId])
  @@index([afterSaleId])
}

model SalesReturnDetail {
  id                         String                    @id @default(cuid())
  returnId                   String
  orderItemId                String
  productId                  String
  quantity                   Decimal                   @db.Decimal(12, 3)
  approvedQuantity           Decimal?                  @db.Decimal(12, 3)
  receivedQuantity           Decimal                   @default(0) @db.Decimal(12, 3)
  refundEligibleQuantity     Decimal                   @default(0) @db.Decimal(12, 3)
  refundedQuantity           Decimal                   @default(0) @db.Decimal(12, 3)
  salesUnit                  ProductUnit?
  unitPriceCents             Int
  refundAmountCents          Int
  costAdjustmentCents        Int                       @default(0)
  reason                     String
  status                     String                    @default("WAITING_INSPECTION")
  inspectionStatus           InventoryStatus?
  inspectionApprovalStatus   InspectionApprovalStatus?
  inspectionApprovedQuantity Decimal?                  @db.Decimal(12, 3)
  inspectionApprovedById     String?
  inspectionApprovedAt       DateTime?
  sourceOutboundBatchId      String?
  inventoryBatchId           String?
  costStatus                 CostVerificationStatus?
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt

  @@index([returnId])
  @@index([orderItemId])
  @@index([productId])
  @@index([sourceOutboundBatchId])
}

model PurchaseReturn {
  id                    String               @id @default(cuid())
  storeId               String
  executionStoreId      String
  returnNo              String               @unique
  purchaseOrderId       String
  supplierId            String?
  supplierName          String?
  status                PurchaseReturnStatus @default(DRAFT)
  returnMode            ReturnMode           @default(PHYSICAL_RETURN)
  settlementMode        String               @default("PAYABLE_OFFSET")
  reason                String
  requestedAmountCents  Int                  @default(0)
  confirmedAmountCents  Int?
  totalAmountCents      Int                  @default(0)
  refundAmountCents     Int                  @default(0)
  payableOffsetCents    Int                  @default(0)
  settledAmountCents    Int                  @default(0)
  businessApprovedById  String?
  financialApprovedById String?
  approvedById          String?
  cancelReason          String?
  closedAt              DateTime?
  createdById           String
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([storeId, status, createdAt])
  @@index([executionStoreId, status, createdAt])
  @@index([purchaseOrderId])
  @@index([supplierId])
}

model PurchaseReturnDetail {
  id                  String   @id @default(cuid())
  returnId            String
  purchaseOrderItemId String
  productId           String
  batchId             String
  quantity            Decimal  @db.Decimal(12, 3)
  approvedQuantity    Decimal? @db.Decimal(12, 3)
  outboundQuantity    Decimal  @default(0) @db.Decimal(12, 3)
  unitCostCents       Int
  refundAmountCents   Int
  payableOffsetCents  Int      @default(0)
  reason              String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([returnId])
  @@index([batchId])
  @@index([purchaseOrderItemId])
  @@index([productId])
}

model SupplierReturnSettlementAdjustment {
  id                       String                     @id @default(cuid())
  purchaseReturnId         String
  supplierId               String?
  sequenceNo               Int
  status                   SettlementAdjustmentStatus @default(PENDING)
  settlementMode           String
  refundAmountCents        Int                        @default(0)
  payableOffsetAmountCents Int                        @default(0)
  exchangeQuantity         Decimal?                   @db.Decimal(12, 3)
  exchangeAmountCents      Int                        @default(0)
  supplierDocumentNo       String?
  differenceReason         String?
  paymentRecordId          String?
  idempotencyKey           String?
  reason                   String?
  createdById              String
  confirmedById            String?
  reversedById             String?
  createdAt                DateTime                   @default(now())
  confirmedAt              DateTime?
  reversedAt               DateTime?

  @@unique([purchaseReturnId, sequenceNo])
  @@unique([purchaseReturnId, idempotencyKey])
  @@index([purchaseReturnId, status])
}

enum ReturnFinancialAdjustmentType {
  REVENUE_REVERSAL
  MATERIAL_COST_REVERSAL
  COMMISSION_REVERSAL
  RECEIPT_REVERSAL
  COST_DIFFERENCE
}

model ReturnFinancialAdjustment {
  id               String                        @id @default(cuid())
  storeId          String
  returnType       String
  returnId         String
  returnDetailId   String?
  type             ReturnFinancialAdjustmentType
  amountCents      Int
  originalValue    Json                          @default("{}")
  newValue         Json                          @default("{}")
  calculationBasis Json                          @default("{}")
  idempotencyKey   String
  createdById      String
  createdAt        DateTime                      @default(now())

  @@unique([returnType, returnId, type, idempotencyKey])
  @@index([returnType, returnId, createdAt])
}

model ReturnAction {
  id                     String   @id @default(cuid())
  returnType             String
  returnId               String
  returnDetailId         String?
  batchId                String?
  targetStatus           String?
  approvedQuantity       Decimal? @db.Decimal(12, 3)
  approvalType           String?
  settlementAdjustmentId String?
  actionType             String
  status                 String   @default("SUCCEEDED")
  actorId                String
  idempotencyKey         String
  requestSummary         Json     @default("{}")
  resultSummary          Json     @default("{}")
  metadata               Json     @default("{}")
  createdAt              DateTime @default(now())

  @@unique([returnType, returnId, actionType, idempotencyKey])
  @@index([returnType, returnId, createdAt])
  @@index([returnDetailId, actionType])
}

enum PermissionRoleType {
  SYSTEM
  CUSTOM
}

enum PermissionRoleStatus {
  ACTIVE
  DISABLED
}

enum PermissionPolicyVersionStatus {
  DRAFT
  VALIDATED
  PUBLISHED
  ROLLED_BACK
  VALIDATION_FAILED
}

enum PermissionBindingStatus {
  ACTIVE
  DISABLED
}

enum PermissionScopeType {
  HQ
  STORE
}

model PermissionDefinition {
  code            String   @id
  name            String
  resource        String
  actions         String[]
  supportedScopes String[]
  status          String   @default("ACTIVE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([resource, status])
}

model PermissionRole {
  id          String               @id @default(cuid())
  code        String               @unique
  name        String
  description String?
  type        PermissionRoleType   @default(CUSTOM)
  status      PermissionRoleStatus @default(ACTIVE)
  createdById String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([status, type])
}

model PermissionRoleGrant {
  id             String @id @default(cuid())
  roleId         String
  permissionCode String
  action         String
  scope          String

  @@unique([roleId, permissionCode, action, scope])
  @@index([permissionCode, action, scope])
}

model PermissionRoleBinding {
  id          String                  @id @default(cuid())
  userId      String
  roleId      String
  scopeType   PermissionScopeType
  storeId     String?
  status      PermissionBindingStatus @default(ACTIVE)
  effectiveAt DateTime                @default(now())
  expiredAt   DateTime?
  createdById String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@unique([userId, roleId, scopeType, storeId])
  @@index([userId, status, effectiveAt, expiredAt])
  @@index([storeId, status])
}

model PermissionPolicyVersion {
  id          String                        @id @default(cuid())
  version     Int                           @unique
  status      PermissionPolicyVersionStatus
  payload     Json
  createdById String?
  publishedAt DateTime?
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt

  @@index([status, createdAt(sort: Desc)])
}
