<view class="page">
  <view wx:if="{{task}}" class="panel hero">
    <text class="eyebrow">售后详情</text>
    <text class="title">{{task.title}}</text>
    <text class="subtitle">{{task.orderLabel}} · {{task.statusLabel}}</text>
  </view>

  <view wx:if="{{!task}}" class="empty">{{emptyText}}</view>

  <view wx:if="{{task}}" class="panel">
    <text class="section-title">处理信息</text>
    <view class="row">
      <text>责任判定</text>
      <text class="badge">{{task.responsibilityLabel}}</text>
    </view>
    <view class="row">
      <text>质保关联</text>
      <text>{{task.warrantyLabel}}</text>
    </view>
    <view class="row">
      <text>客户</text>
      <text>{{task.customerLabel}}</text>
    </view>
    <view class="row">
      <text>车辆</text>
      <text>{{task.vehicleLabel}}</text>
    </view>
  </view>

  <view wx:if="{{task}}" class="panel">
    <text class="section-title">售后描述</text>
    <text class="description">{{task.description}}</text>
    <button class="secondary" bindtap="backToList">返回售后列表</button>
  </view>
</view>
