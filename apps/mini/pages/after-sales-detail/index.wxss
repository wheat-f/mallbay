.page {
  min-height: 100vh;
  padding: 32rpx;
  background: #f8fafc;
  box-sizing: border-box;
}

.panel {
  margin-bottom: 20rpx;
  padding: 28rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 18rpx;
  background: #ffffff;
}

.hero {
  background: #0f3a5f;
  color: #ffffff;
}

.eyebrow,
.subtitle {
  display: block;
  color: #dbeafe;
  font-size: 26rpx;
  line-height: 1.6;
}

.title {
  display: block;
  margin-top: 8rpx;
  font-size: 40rpx;
  font-weight: 700;
}

.section-title {
  display: block;
  margin-bottom: 18rpx;
  color: #111827;
  font-size: 32rpx;
  font-weight: 700;
}

.row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #e5e7eb;
  color: #334155;
  font-size: 28rpx;
}

.row:last-child {
  border-bottom: 0;
}

.badge {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #fef3c7;
  color: #92400e;
  font-size: 24rpx;
}

.description,
.empty {
  display: block;
  color: #64748b;
  font-size: 28rpx;
  line-height: 1.7;
}

.secondary {
  margin-top: 24rpx;
  border-radius: 14rpx;
  color: #0f3a5f;
}
