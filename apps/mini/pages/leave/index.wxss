.page {
  min-height: 100vh;
  padding: 32rpx;
  background: #f8fafc;
  box-sizing: border-box;
}

.panel {
  padding: 28rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.08);
}

.title {
  display: block;
  margin-bottom: 28rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #111827;
}

.field {
  margin-bottom: 24rpx;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: #475569;
}

.picker,
.textarea {
  width: 100%;
  min-height: 88rpx;
  padding: 22rpx;
  border: 1rpx solid #dbe3ef;
  border-radius: 16rpx;
  background: #f8fafc;
  color: #111827;
  box-sizing: border-box;
}

.textarea {
  height: 180rpx;
}

.primary {
  margin-top: 8rpx;
  background: #2563eb;
  color: #ffffff;
  border-radius: 16rpx;
}
