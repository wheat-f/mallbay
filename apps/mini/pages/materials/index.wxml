<view class="page">
  <view class="panel hero">
    <text class="eyebrow">施工物料</text>
    <text class="title">物料核验</text>
    <text class="subtitle">开工前核对批次、耗材和照片存证。</text>
  </view>

  <view class="panel">
    <text class="section-title">当前任务</text>
    <view wx:if="{{currentTask}}" class="task">
      <text class="task-title">{{currentTask.orderNo}}</text>
      <text class="meta">{{currentTask.customerName}} · {{currentTask.vehicleLabel}}</text>
      <button class="secondary" bindtap="openTaskDetail">查看任务详情</button>
    </view>
    <view wx:else class="empty">暂无缓存任务，请先同步施工任务</view>
  </view>

  <view class="panel">
    <text class="section-title">批次追溯</text>
    <view wx:for="{{batches}}" wx:key="batchNo" class="batch">
      <view>
        <text class="batch-no">{{item.batchNo}}</text>
        <text class="meta">{{item.product}}</text>
        <text class="meta">{{item.spec}}</text>
      </view>
      <text class="badge">{{item.status}}</text>
      <text class="meta">{{item.location}}</text>
    </view>
  </view>

  <view class="panel">
    <text class="section-title">施工耗材</text>
    <view class="chips">
      <text wx:for="{{consumables}}" wx:key="*this">{{item}}</text>
    </view>
  </view>
</view>
