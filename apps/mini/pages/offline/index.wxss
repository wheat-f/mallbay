.page {
  min-height: 100vh;
  padding: 32rpx;
  background: #f8fafc;
}

.notice {
  padding: 28rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  background: #ffffff;
}

.title {
  display: block;
  margin-bottom: 12rpx;
  color: #111827;
  font-size: 36rpx;
  font-weight: 700;
}

.desc {
  display: block;
  margin-top: 8rpx;
  color: #475569;
  font-size: 26rpx;
}
