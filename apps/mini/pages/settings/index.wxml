<view class="page">
  <view class="form">
    <text class="title">连接配置</text>
    <text class="desc">用于开发和真机调试时注入 API 地址、access token 和门店 ID。</text>

    <view class="field">
      <text class="label">API 地址</text>
      <input value="{{apiBaseUrl}}" data-field="apiBaseUrl" bindinput="onInput" placeholder="http://localhost:4001" />
    </view>

    <view class="field">
      <text class="label">Access Token</text>
      <textarea value="{{token}}" data-field="token" bindinput="onInput" placeholder="粘贴登录后的 JWT access token" />
    </view>

    <view class="field">
      <text class="label">门店 ID</text>
      <input value="{{storeId}}" data-field="storeId" bindinput="onInput" placeholder="storeId" />
    </view>

    <button type="primary" bindtap="saveConfig">保存配置</button>
    <button loading="{{loggingIn}}" bindtap="loginWithWechat">微信一键登录</button>
  </view>
</view>
