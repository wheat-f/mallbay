.page {
  min-height: 100vh;
  padding: 32rpx;
  background: #f8fafc;
}

.form {
  padding: 28rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  background: #ffffff;
}

.title {
  display: block;
  color: #111827;
  font-size: 38rpx;
  font-weight: 700;
}

.desc {
  display: block;
  margin-top: 10rpx;
  color: #64748b;
  font-size: 26rpx;
  line-height: 1.6;
}

.field {
  margin: 28rpx 0;
}

.label {
  display: block;
  margin-bottom: 10rpx;
  color: #334155;
  font-size: 26rpx;
  font-weight: 600;
}

input,
textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 72rpx;
  padding: 16rpx;
  border: 1rpx solid #cbd5e1;
  border-radius: 8rpx;
  background: #ffffff;
  color: #111827;
  font-size: 26rpx;
}

textarea {
  min-height: 180rpx;
}
