.page {
  min-height: 100vh;
  padding: 32rpx;
  background: #f8fafc;
}

.section {
  margin-bottom: 20rpx;
  padding: 28rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  background: #ffffff;
}

.label {
  display: block;
  margin-bottom: 8rpx;
  color: #64748b;
  font-size: 24rpx;
}

.value {
  color: #111827;
  font-size: 32rpx;
  font-weight: 600;
}

.actions {
  display: grid;
  gap: 16rpx;
}
