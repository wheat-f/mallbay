.page {
  min-height: 100vh;
  padding: 32rpx;
  background: #f8fafc;
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #111827;
}

.badge {
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background: #dcfce7;
  color: #166534;
  font-size: 24rpx;
}

.task {
  margin-bottom: 20rpx;
  padding: 28rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  background: #ffffff;
}

.task-title {
  display: block;
  margin-bottom: 8rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
}

.task-meta {
  color: #64748b;
  font-size: 26rpx;
}
