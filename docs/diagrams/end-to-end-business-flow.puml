@startuml
title MallBay 当前订单端到端业务流程

skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Microsoft YaHei
skinparam activity {
  BorderColor #0F3A5F
  BackgroundColor #F7FAFC
  DiamondBorderColor #0F3A5F
  DiamondBackgroundColor #EAF3FB
  StartColor #0F3A5F
  EndColor #0F3A5F
}
skinparam note {
  BorderColor #8AA4B8
  BackgroundColor #FFF8E6
}

start

partition "销售 / 客户订单" {
  :选择或创建客户与车辆;
  :创建订单（允许零定金）;
  :记录产品、施工方案和应收金额;
}

partition "库存 / 采购" {
  :查看订单需求和可用批次;
  if (库存是否充足?) then (充足)
    :人工选择批次和数量锁库;
  else (缺货)
    :生成采购需求;
    :创建并审批采购订单;
    :采购到货;
    :采购/店长人工确认入库;
    :重新进行库存匹配;
    :人工选择批次和数量锁库;
  endif
  :出库;
}

partition "施工 / 车间" {
  :派工;
  :施工人员领取物料;
  :上传施工前、施工中、施工后照片;
  :开工并记录施工过程;
  :施工完成;
}

partition "质检 / 返工" {
  if (质检是否通过?) then (通过)
    :进入待交付阶段;
  else (不通过)
    :进入独立返工状态;
    :复用施工记录快照和审计事件记录返工;
    :返工后重新质检;
    if (复检通过?) then (通过)
      :进入待交付阶段;
    else (不通过)
      :继续返工并保留历史记录;
    endif
  endif
}

partition "质保 / 收款" {
  :质检通过后允许生成质保卡;
  if (尾款是否结清?) then (是)
    :系统自动执行最终交付事务;
    :无质保卡则自动创建并同时生效;
    :已有待生效质保卡改为 ACTIVE;
    :质保起始日写为最终交付日;
    :订单标记 COMPLETED;
    :关闭尾款待办并写入审计;
  else (否)
    :生成 PENDING_ACTIVATION 待生效质保卡;
    :生成销售/财务站内尾款待办;
    :等待尾款结清;
  endif
}

partition "客服 / 质保售后" {
  :客户后续反馈;
  if (是否产生售后?) then (是)
    :创建售后单;
    :派单、上传问题证据、责任判定和处理;
    :关闭售后单;
  else (否)
    :保留质保和施工追溯;
  endif
}

partition "财务 / 经营分析" {
  :处理收款、发票、返利、费用和报销;
  :生成经营报表和提成数据;
}

stop

legend right
  |= 关键数据落点 |
  | 订单 | Order / OrderItem / OrderPayment |
  | 库存 | InventoryBatch / InventoryAllocation / InventoryMovement |
  | 采购 | PurchaseRequirement / PurchaseOrder |
  | 施工 | ConstructionRecord / ConstructionAssignment / AuditEvent |
  | 质保 | Warranty（PENDING_ACTIVATION / ACTIVE / EXPIRED / VOIDED） |
  | 待办 | Notification（todoKey / handledAt） |
  | 售后财务 | AfterSale / Invoice / CustomerRebate / PaymentRecord |
endlegend

@enduml
