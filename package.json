{
  "name": "mallbay",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "dev": "nx run-many -t dev --parallel=2",
    "dev:clean": "lsof -ti :3000,3001 | xargs kill -9 2>/dev/null; pnpm dev",
    "dev:web": "nx dev web",
    "dev:api": "nx dev api",
    "build": "nx run-many -t build",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "prisma:generate": "pnpm --filter @mallbay/api prisma:generate",
    "prisma:migrate": "pnpm --filter @mallbay/api prisma:migrate"
  },
  "dependencies": {
    "@ant-design/nextjs-registry": "^1.3.0",
    "@nestjs/common": "^11.1.19",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.19",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.19",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tanstack/react-query": "^5.100.9",
    "antd": "^6.3.7",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^5.10.1",
    "next": "^16.2.6",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.20.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.75.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.19",
    "@nx/eslint": "^22.7.1",
    "@nx/jest": "^22.7.1",
    "@nx/nest": "^22.7.1",
    "@nx/next": "^22.7.1",
    "@nx/node": "^22.7.1",
    "@nx/workspace": "^22.7.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.2.6",
    "nx": "^22.7.1",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@parcel/watcher",
      "@prisma/engines",
      "bcrypt",
      "less",
      "nx",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
